/build/
/CE/web/dist/
/CE/web/dist-scenery/
/CE/web/node_modules/
/CE/web/vite*.log
/CE/web/node_modules/.vite/
/CE/web/node_modules/.vite-temp/
/CE/web/node_modules/.package-lock.json
/Ctrlr/
# JUCE is vendored with this repository and should be tracked.
/Docs/
/out/
# Scratch: QA screenshots, harness scripts, logs, mockups.
/tmp/
# Per-panel export output (generated VST3s).
/export-out/

# Prebuilt player templates. Build outputs (cmake -DCEDITOR_TEMPLATE_PLAYER=ON), staged here for
# the compiler-free export path and by the installer. Tens of MB per format, and reproducible.
/templates/
# Publish-only build of the API explorer: gen-api-explorer.mjs --standalone, with the screenshots
# baked in as data URIs. docs/api-explorer.html is the checked-in page; this one is ~1.9MB of the
# same content and is regenerated whenever it is hosted.
/docs/api-explorer.standalone.html

/.claude/
*.cache
*.exe
# ...except the vendored JUCE helpers. juceaide and the LV2/VST3 helpers are
# part of the JUCE 8.0.7 install this repo carries, and find_package(JUCE)
# hard-fails without them. The blanket *.exe above had been quietly excluding
# them: JUCE/include and JUCE/lib were committed, JUCE/bin never was, and CI
# could not configure as a result.
!JUCE/bin/**
*.obj
*.pdb
*.user
*.suo
*.vs
.vscode
.windsurf
.DS_Store
.windsurfrules
MoveAllFiles.bat
/Claude.md
build-installer.log
