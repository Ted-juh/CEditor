{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native",
      "displayName": "Native (Ninja Multi-Config)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/native"
    },
    {
      "name": "hostage-windows",
      "displayName": "HoSTage standalone (Windows x64)",
      "inherits": "native",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "binaryDir": "${sourceDir}/build/hostage-windows",
      "cacheVariables": {
        "CEDITOR_DEV_MODE": "OFF",
        "CEDITOR_BUILD_APP": "ON",
        "CEDITOR_SCANNER_WORKER": "ON",
        "CEDITOR_PLUGIN_WORKER": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native",
      "configuration": "Debug"
    },
    {
      "name": "native-release",
      "configurePreset": "native",
      "configuration": "Release"
    },
    {
      "name": "hostage-windows-release",
      "configurePreset": "hostage-windows",
      "configuration": "Release",
      "targets": ["HoSTageWindows"]
    }
  ]
}
