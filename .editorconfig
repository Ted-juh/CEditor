# EditorConfig — keeps whitespace consistent across editors before any
# formatter runs. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{js,mjs,svelte,json,css,html}]
indent_size = 2

[*.{cpp,h,hpp}]
indent_size = 4

[*.md]
# Markdown uses trailing double-spaces for hard breaks.
trim_trailing_whitespace = false

[*.{cmd,bat,ps1}]
end_of_line = crlf
