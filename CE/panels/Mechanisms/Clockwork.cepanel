  "scripts": [
    {
      "id": "mechanism_clockwork_1",
      "name": "Clock",
      "language": "javascript",
      "source": "// The clock tells the real time: each hand is a scene of one turn, held where the time puts it,\n// once a second.\nfunction setHands() {\n  var now = new Date();\n  var s = now.getSeconds();\n  var m = now.getMinutes() + s / 60;\n  var h = (now.getHours() % 12) + m / 60;\n  animateSeek('Seconds', s / 60);\n  animateSeek('Minutes', m / 60);\n  animateSeek('Hours', h / 12);\n  after(1000, setHands);\n}\nsetHands();\n"
    }
  ],
