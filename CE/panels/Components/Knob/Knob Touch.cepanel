                "Background.Border.colour": "{accent.hot}"
              }
            }
          }
        }
      },
      "fields": {}
    },
    {
      "format": "ceditor-animation-preset",
      "version": 1,
      "id": "ce:knob:readout",
      "name": "Readout",
      "category": "Knob",
      "tags": [
        "Touch",
        "while turning"
      ],
      "size": "recipe",
      "colours": "keep",
      "revision": 1,
      "animations": {
        "readoutIn": {
          "_type": "Animation",
          "name": "readoutIn",
          "enabled": true,
          "kind": "transition",
          "trigger": {
            "type": "stateChange",
            "from": [
              "*"
            ],
            "to": [
              "dragging"
            ],
            "reverse": false
          },
          "targets": [
            {
              "path": "Parts.labelCurrent.opacity",
              "properties": [
                "opacity"
              ]
            }
          ],
          "duration": 120,
          "delay": 0,
          "easing": "outQuad"
        },
        "readoutOut": {
          "_type": "Animation",
          "name": "readoutOut",
          "enabled": true,
          "kind": "transition",
          "trigger": {
            "type": "stateChange",
            "from": [
              "dragging"
            ],
            "to": [
              "*"
            ],
            "leaving": true
          },
          "targets": [
            {
              "path": "Parts.labelCurrent.opacity",
              "properties": [
                "opacity"
              ]
            }
          ],
          "duration": 400,
          "delay": 600,
          "easing": "inOutQuad"
        }
      },
      "states": {
        "Dragging": {
          "when": {
            "dragging": true
          },
          "patches": {
            "component": {},
            "parts": {
              "labelCurrent": {
                "opacity": 1
              }
            }
          }
        }
      },
      "fields": {
        "Behavior.showHandleLabels": true,
        "Parts.labelCurrent.opacity": 0
      }
    },
