  "scripts": [
    {
      "id": "component_knob-numbers_1",
      "name": "The synth",
      "language": "javascript",
      "source": "// Stands in for a synth sending this knob new values: a value from outside, which the\n// From the synth preset answers and a turn by hand does not.\nfunction send() {\n  set('FromTheSynth.normalizedValue', 0.15 + Math.random() * 0.7);\n  after(2500, send);\n}\nafter(1200, send);\n"
    }
  ],
