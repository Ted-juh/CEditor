  "scripts": [
    {
      "id": "component_slider-numbers_1",
      "name": "The synth",
      "language": "javascript",
      "source": "// Stands in for a synth sending this slider new values: a value from outside, which the\n// From the synth preset answers and a move by hand does not.\nfunction send() {\n  set('FromTheSynth.normalizedValue', 0.15 + Math.random() * 0.7);\n  after(2500, send);\n}\nafter(1200, send);\n"
    }
  ],
