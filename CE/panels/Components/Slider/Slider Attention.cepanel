  "scripts": [
    {
      "id": "component_slider-attention_1",
      "name": "Look here",
      "language": "javascript",
      "source": "// Plays the Reach full slider's own animation every four seconds, as a panel would to draw\n// the eye to one control: ce.anim.play(control, animation).\nfunction lookHere() {\n  ce.anim.play('ReachFull', 'reachFull');\n  after(4000, lookHere);\n}\nafter(1500, lookHere);\n"
    }
  ],
