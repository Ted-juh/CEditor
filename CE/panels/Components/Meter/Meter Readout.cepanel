  "scripts": [
    {
      "id": "component_meter-readout_1",
      "name": "Signal",
      "language": "javascript",
      "source": "// Stands in for a signal: nothing is plugged in, so each meter's level wanders, in decibels,\n// and the Label that shows its reading changes with it.\nconst meters = [\"Odometer\",\"Reel\",\"Roll\",\"Push\",\"Crossfade\"];\nconst level = {};\nfunction wander() {\n  for (const name of meters) {\n    const next = Math.min(-3, Math.max(-42, (level[name] ?? -18) + (Math.random() - 0.5) * 14));\n    level[name] = next;\n    ce.components.meter.value(name, next);\n  }\n  after(1200, wander);\n}\nafter(900, wander);\n"
    }
  ],
  "scripting": {
    "enabled": true,
    "runInPreview": true,
    "runOnExport": true
  },
  "controlSet": {
    "id": "ivory"
  },
