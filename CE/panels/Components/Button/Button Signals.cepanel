  "scripts": [
    {
      "id": "component_button-signals_1",
      "name": "Alert",
      "language": "javascript",
      "source": "// Plays the Alert button's own animation every five seconds, as a panel calls for attention:\n// ce.anim.play(control, animation).\nfunction alert() {\n  ce.anim.play('Alert', 'alert');\n  after(5000, alert);\n}\nafter(2000, alert);\n"
    }
  ],
