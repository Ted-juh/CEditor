  "scripts": [
    {
      "id": "component_button-attention_1",
      "name": "Look here",
      "language": "javascript",
      "source": "// Plays the Look here button's own animation every four seconds, as a panel would to draw the\n// eye to one control: ce.anim.play(control, animation).\nfunction lookHere() {\n  ce.anim.play('LookHere', 'lookHere');\n  after(4000, lookHere);\n}\nafter(1500, lookHere);\n"
    }
  ],
