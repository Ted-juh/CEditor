  "scripts": [
    {
      "id": "component_button-light_1",
      "name": "The synth",
      "language": "javascript",
      "source": "// Stands in for a synth switching this toggle: a change from outside, which the From the\n// synth preset answers and a click does not.\nlet switchedOn = false;\nfunction send() {\n  switchedOn = !switchedOn;\n  set('FromTheSynth.normalizedValue', switchedOn ? 1 : 0);\n  after(3000, send);\n}\nafter(1200, send);\n"
    }
  ],
  "scripting": {
    "enabled": true,
    "runInPreview": true,
    "runOnExport": true
  },
