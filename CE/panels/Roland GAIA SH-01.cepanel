            "gaia_lbl_615": {
              "_children": {
                "Core": {
                  "name": "arp.duration.caption",
                  "tooltip": "Gate length as a percentage of a step (for a tied note, its final step). Full / FUL sustains until the next note event, even across untied steps; it is not simply 100%. Note-block length is edited separately in the pattern grid.\nThese performance controls send live; only note blocks and END STEP use Send Pattern.",
                  "id": "gaia_lbl_615",
                  "tabPageId": "arpeggiator",
                  "controlType": "Label"
                },
                "Transform": {
                  "x": 8,
                  "y": 58.99999999999999,
