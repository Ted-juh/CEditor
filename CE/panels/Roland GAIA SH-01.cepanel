                    "gaia_arp_grid_612": {
                      "_children": {
                        "Core": {
                          "name": "arp_grid",
                          "tooltip": "Step timing relative to a quarter-note beat. Straight: evenly spaced; light/heavy shuffle: uneven pairs; triplet: three 1/8 steps or six 1/16 steps per beat. This changes timing, not the number of steps.\nThese performance controls send live; only note blocks and END STEP use Send Pattern.\nHardware codes: 04_ = 1/4 straight; 08_ = 1/8 straight; 08L = 1/8 light shuffle; 08H = 1/8 heavy shuffle; 08t = 1/8 triplet; 16_ = 1/16 straight; 16L = 1/16 light shuffle; 16H = 1/16 heavy shuffle; 16t = 1/16 triplet",
                          "id": "gaia_arp_grid_612",
                          "description": "Arpeggio Grid — 10 00 0C 00",
                          "controlType": "Combobox"
                        },
                        "Transform": {
                          "x": 8,
                          "y": 34.416666666666664,
                          "width": 152,
                          "height": 16.857142857142854
                        },
                        "Text": {
                          "content": "grid",
                          "_children": {
                            "Font": {
                              "size": 11
                            }
                          }
                        },
                        "Behavior": {
                          "defaultValue": "04"
                        },
                        "Value": {
                          "rows": [
                            {
