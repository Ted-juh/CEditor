                      "_children": {
                        "Core": {
                          "name": "arp_grid_caption",
                          "tooltip": "Step timing relative to a quarter-note beat. Straight: evenly spaced; light/heavy shuffle: uneven pairs; triplet: three 1/8 steps or six 1/16 steps per beat. This changes timing, not the number of steps.\nThese performance controls send live; only note blocks and END STEP use Send Pattern.",
                          "id": "gaia_lbl_613",
                          "controlType": "Label"
                        },
                        "Transform": {
