                    "gaia_lbl_621": {
                      "_children": {
                        "Core": {
                          "name": "arp_accentRate_caption",
                          "tooltip": "Pattern accent strength. 0%: even dynamics. 100%: the full velocity differences programmed in the pattern. Intermediate settings reduce those differences; this is not output volume.\nThese performance controls send live; only note blocks and END STEP use Send Pattern.",
                          "id": "gaia_lbl_621",
                          "controlType": "Label"
                        },
                        "Transform": {
                          "y": 174.89285714285714,
                          "width": 56,
                          "height": 25.285714285714285
                        },
                        "Background": {
                          "_children": {
                            "Fill": {
                              "colour": "00000000"
                            },
                            "Border": {
                              "enabled": false,
                              "thickness": 0
                            }
                          }
                        },
                        "Text": {
                          "content": "ACCENT\n0% (even)",
                          "_children": {
                            "Fill": {
                              "colour": "FFAEBAC6"
                            },
                            "Font": {
                              "size": 9,
                              "letterSpacing": 0.3,
                              "bold": false
                            },
                            "Multiline": {
                              "overflowMode": "shrink",
                              "maxLines": 3,
                              "fitMode": "shrink",
                              "lineHeight": 1.15
                            }
                          }
                        },
                        "ContentLayout": {
                          "paddingLeft": 2,
                          "paddingRight": 2,
                          "paddingTop": 1,
                          "paddingBottom": 1
                        }
                      },
                      "_type": "Control"
                    },
