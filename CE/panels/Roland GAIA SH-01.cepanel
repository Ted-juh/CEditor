    {
      "id": "gaia_effect_parameter_labels",
      "name": "Effect captions → selected type",
      "language": "javascript",
      "source": "// Effect parameter captions -> the manual's names for the selected type.\n//\n// Generated by tools/scripts/gaia-panel/effect-parameters.mjs from its own table. A type with no\n// name for a given knob keeps the generic PARAM n, so a half-filled table is useful. Controls are\n// addressed by ID: every bound control here is named after its parameter (\"distortion.type\") and\n// the script path syntax splits on dots, so a name would resolve to nothing.\n\nvar BLOCKS = {\n  \"distortion\": {\n    \"captions\": [\n      \"gaia_lbl_631\",\n      \"gaia_lbl_633\",\n      \"gaia_lbl_635\",\n      \"gaia_lbl_637\"\n    ],\n    \"type\": \"gaia_distortion_type_628\",\n    \"names\": {\n      \"1\": [\n        \"DRIVE\",\n        \"TYPE\",\n        \"PRESENCE\",\n        \"LEVEL\"\n      ],\n      \"2\": [\n        \"DRIVE\",\n        \"TYPE\",\n        \"PRESENCE\",\n        \"LEVEL\"\n      ],\n      \"3\": [\n        \"SAMPLE RATE\",\n        \"BIT DOWN\",\n        \"FILTER\",\n        \"LEVEL\"\n      ]\n    }\n  },\n  \"flanger\": {\n    \"captions\": [\n      \"gaia_lbl_643\",\n      \"gaia_lbl_645\",\n      \"gaia_lbl_647\",\n      \"gaia_lbl_649\"\n    ],\n    \"type\": \"gaia_flanger_type_640\",\n    \"names\": {\n      \"1\": [\n        \"FEEDBACK\",\n        \"DEPTH\",\n        \"RATE\",\n        \"LEVEL\"\n      ],\n      \"2\": [\n        \"RESONANCE\",\n        \"DEPTH\",\n        \"RATE\",\n        \"LEVEL\"\n      ],\n      \"3\": [\n        \"PITCH\",\n        \"DETUNE\",\n        \"PITCH SEL\",\n        \"LEVEL\"\n      ]\n    }\n  },\n  \"delay\": {\n    \"captions\": [\n      \"gaia_lbl_655\",\n      \"gaia_lbl_657\",\n      \"gaia_lbl_659\",\n      \"gaia_lbl_661\"\n    ],\n    \"type\": \"gaia_delay_type_652\",\n    \"names\": {\n      \"1\": [\n        \"TIME\",\n        \"FEEDBACK\",\n        \"HIGH DAMP\",\n        \"LEVEL\"\n      ],\n      \"2\": [\n        \"TIME\",\n        \"FEEDBACK\",\n        \"HIGH DAMP\",\n        \"LEVEL\"\n      ]\n    }\n  },\n  \"reverb\": {\n    \"captions\": [\n      \"gaia_lbl_667\",\n      \"gaia_lbl_669\",\n      \"gaia_lbl_671\",\n      \"gaia_lbl_673\"\n    ],\n    \"type\": \"gaia_reverb_type_664\",\n    \"names\": {\n      \"1\": [\n        \"TIME\",\n        \"TYPE\",\n        \"HIGH DAMP\",\n        \"LEVEL\"\n      ]\n    }\n  }\n};\n\nfunction relabel(effect) {\n  var block = BLOCKS[effect];\n  var selected = get(block.type);\n  var names = block.names[String(selected)];\n  for (var i = 0; i < block.captions.length; i++) {\n    set(block.captions[i] + \".text.content\", names ? names[i] : \"PARAM \" + (i + 1));\n  }\n}\n\nfunction onPanelLoad() {\n  var effects = Object.keys(BLOCKS);\n  for (var i = 0; i < effects.length; i++) {\n    (function (effect) {\n      relabel(effect);\n      watch(BLOCKS[effect].type + \".value\", function () { relabel(effect); });\n    }(effects[i]));\n  }\n}\n",
      "scope": "panel",
      "target": "*",
      "event": "onPanelLoad",
      "enabled": true,
      "description": "Renames each effect block's four parameter captions when its TYPE selector moves.",
      "group": ""
    },
    {
      "id": "gaia_effect_probe",
      "name": "Effect probe (diagnostic)",
      "language": "javascript",
      "source": "// Which address does each effect knob drive? Ask the instrument.\n//\n// Generated by tools/scripts/gaia-panel/effect-probe.mjs. A DIAGNOSTIC — leave it disabled unless\n// you are filling in EFFECT_PARAMETER_NAMES, and switch it off again afterwards.\n//\n// HOW TO USE IT, from the script console:\n//\n//   1. On the GAIA, select the effect and the TYPE you are mapping (e.g. DISTORTION -> DIST).\n//   2. run(\"fxProbe\", \"distortion\")        reads the block and remembers it\n//   3. Move ONE knob, as the console tells you. The GAIA reaches four parameters with two knobs:\n//        CONTROL 1  turn CONTROL 1\n//        CONTROL 2  SHIFT (cancel) + turn CONTROL 1\n//        CONTROL 3  SHIFT (cancel) + turn LEVEL\n//        LEVEL      turn LEVEL\n//   4. run(\"fxMark\", \"CONTROL 1\")          reads again and says which slot changed\n//   5. Repeat 3-4 for the other three, then run(\"fxReport\") for the summary.\n//\n// If nothing is reported as changed, the instrument is probably not transmitting panel moves —\n// check its MIDI transmit / \"Tx Edit\" setting before concluding the knob is dead.\n\nvar BLOCKS = {\n  \"distortion\": {\n    \"request\": \"requestDistortion\",\n    \"prefix\": \"distortion.parameter\",\n    \"slots\": 32\n  },\n  \"flanger\": {\n    \"request\": \"requestFlanger\",\n    \"prefix\": \"flanger.parameter\",\n    \"slots\": 20\n  },\n  \"delay\": {\n    \"request\": \"requestDelay\",\n    \"prefix\": \"delay.parameter\",\n    \"slots\": 20\n  },\n  \"reverb\": {\n    \"request\": \"requestReverb\",\n    \"prefix\": \"reverb.parameter\",\n    \"slots\": 20\n  }\n};\n\nvar current = null;      // { effect, values: [...] }\nvar found = {};          // gesture label -> slot number\n\nfunction readBlock(effect) {\n  var block = BLOCKS[effect];\n  var values = [];\n  for (var i = 1; i <= block.slots; i++) {\n    values.push(ce.device.read(block.prefix + i));\n  }\n  return values;\n}\n\nfunction changedSlots(before, after) {\n  var moved = [];\n  for (var i = 0; i < before.length; i++) {\n    if (before[i] !== after[i]) moved.push({ slot: i + 1, from: before[i], to: after[i] });\n  }\n  return moved;\n}\n\nfunction fxProbe(effect) {\n  var key = String(effect || \"distortion\");\n  if (!BLOCKS[key]) {\n    log(\"fxProbe: no block called \" + key + \" — one of: \" + Object.keys(BLOCKS).join(\", \"));\n    return;\n  }\n  ce.device.requestDump(BLOCKS[key].request, function (values, info) {\n    if (!info.ok) {\n      log(\"fxProbe: no dump arrived (\" + info.error + \"). Is the GAIA connected and its ID right?\");\n      return;\n    }\n    current = { effect: key, values: readBlock(key) };\n    found = {};\n    log(\"fxProbe: \" + key + \" read (\" + BLOCKS[key].slots + \" slots). Now move ONE knob, then \"\n      + \"run(\\\"fxMark\\\", \\\"CONTROL 1\\\").\");\n    log(\"  CONTROL 1 = turn CONTROL 1 · CONTROL 2 = SHIFT+CONTROL 1 · \"\n      + \"CONTROL 3 = SHIFT+LEVEL · LEVEL = turn LEVEL\");\n  });\n}\n\nfunction fxMark(gesture) {\n  if (!current) { log(\"fxMark: run(\\\"fxProbe\\\", \\\"distortion\\\") first.\"); return; }\n  var name = String(gesture || \"?\");\n  ce.device.requestDump(BLOCKS[current.effect].request, function (values, info) {\n    if (!info.ok) { log(\"fxMark: no dump arrived (\" + info.error + \")\"); return; }\n    var after = readBlock(current.effect);\n    var moved = changedSlots(current.values, after);\n    current.values = after;\n\n    if (moved.length === 0) {\n      log(\"fxMark(\" + name + \"): nothing changed. Move the knob further, or check the GAIA's \"\n        + \"MIDI transmit setting.\");\n      return;\n    }\n    if (moved.length > 1) {\n      var all = moved.map(function (m) { return m.slot; }).join(\", \");\n      log(\"fxMark(\" + name + \"): \" + moved.length + \" slots moved (\" + all + \") — move one knob at \"\n        + \"a time, and re-run fxProbe to re-baseline.\");\n      return;\n    }\n    found[name] = moved[0].slot;\n    log(\"fxMark(\" + name + \") -> MFX Parameter \" + moved[0].slot\n      + \"  (\" + moved[0].from + \" -> \" + moved[0].to + \")\");\n  });\n}\n\nfunction fxReport() {\n  if (!current) { log(\"fxReport: nothing probed yet.\"); return; }\n  var order = [\"CONTROL 1\",\"CONTROL 2\",\"CONTROL 3\",\"LEVEL\"];\n  var line = [];\n  for (var i = 0; i < order.length; i++) {\n    var slot = found[order[i]];\n    line.push(order[i] + \" = \" + (slot ? \"MFX Parameter \" + slot : \"?\"));\n  }\n  log(\"fxReport \" + current.effect + \": \" + line.join(\" · \"));\n  // The panel shows slots 1..4. If a knob drives anything else, the panel is showing a\n  // parameter nothing turns — worth knowing before the names go in.\n  var outside = [];\n  for (var j = 0; j < order.length; j++) {\n    var s = found[order[j]];\n    if (s && s > 4) outside.push(order[j] + \" -> \" + s);\n  }\n  if (outside.length) {\n    log(\"fxReport: these are OUTSIDE the four the panel shows — \" + outside.join(\", \")\n      + \". layout.mjs is displaying the wrong slots for this type.\");\n  }\n}\n\nfunction onPanelLoad() {\n  defineAction(\"fxProbe\", fxProbe);\n  defineAction(\"fxMark\", fxMark);\n  defineAction(\"fxReport\", fxReport);\n  log(\"Effect probe ready. run(\\\"fxProbe\\\", \\\"distortion\\\") to begin.\");\n}\n",
      "scope": "panel",
      "target": "*",
      "event": "onPanelLoad",
      "enabled": false,
      "description": "Asks the GAIA which MFX Parameter each effect knob drives. Enable, run fxProbe/fxMark/fxReport from the console, then disable again.",
      "group": ""
    },
    {
      "id": "gaia_arpeggio_captions",
      "name": "Arpeggio readable values",
      "language": "javascript",
      "source": "function arpKnobCaption(parameter, raw) {\n  const n = Math.round(Number(raw));\n  if (!Number.isFinite(n)) return '';\n  if (parameter === 'arp.velocity') return 'VELOCITY\\n' + (n === 0 ? 'REAL (played)' : n + ' (fixed)');\n  if (parameter === 'arp.accentRate') return 'ACCENT\\n' + n + '%' + (n === 0 ? ' (even)' : n === 100 ? ' (pattern)' : '');\n  const oct = n - 64;\n  return 'OCTAVE RANGE\\n' + (oct === 0 ? '0 (played range)' : (oct > 0 ? '+' : '') + oct + (Math.abs(oct) === 1 ? ' octave' : ' octaves'));\n}\nvar ENTRIES = [{\"parameter\":\"arp.velocity\",\"control\":\"gaia_arp_velocity_622\",\"caption\":\"gaia_lbl_623\"},{\"parameter\":\"arp.accentRate\",\"control\":\"gaia_arp_accentRate_620\",\"caption\":\"gaia_lbl_621\"},{\"parameter\":\"arp.octaveRange\",\"control\":\"gaia_arp_octaveRange_618\",\"caption\":\"gaia_lbl_619\"}];\nfunction onPanelLoad() {\n  ENTRIES.forEach(function (e) {\n    function refresh() {\n      var text = arpKnobCaption(e.parameter, get(e.control + \".value\"));\n      if (text) set(e.caption + \".text.content\", text);\n    }\n    refresh();\n    watch(e.control + \".value\", refresh);\n  });\n}\n",
      "scope": "panel",
      "target": "*",
      "event": "onPanelLoad",
      "enabled": true,
      "description": "Read-only value captions for the existing rotary controls. No duplicate inputs and no MIDI writes.",
      "group": ""
    },
    {
      "id": "gaia_status_display",
      "name": "GAIA dot-matrix status",
      "language": "javascript",
      "source": "function updateGaiaScreen(texts) {\n  const layouts = get('gaia_status_screen.display.layouts');\n  if (!Array.isArray(layouts)) return;\n  let changed = false;\n  const next = layouts.map(layout => ({ ...layout, zones: layout.zones.map(zone => {\n    if (!(zone.id in texts) || zone.text === String(texts[zone.id])) return zone;\n    changed = true;\n    return { ...zone, text: String(texts[zone.id]) };\n  }) }));\n  if (changed) set('gaia_status_screen.display.layouts', next);\n}\nconst display = (function displayRuntime() {\n  let generation = 0;\n  function onPanelLoad() {\n    const token = ++generation;\n    function refresh() {\n      if (token !== generation) return;\n      const profile = ce.device.profile('Roland GAIA SH-01');\n      const route = !profile ? 'MIDI: NO PROFILE / ROUTE'\n        : !profile.midiInput || !profile.midiDestination ? 'MIDI: INPUT / OUTPUT NOT MAPPED'\n          : profile.connected ? 'MIDI SESSION READY - VALUES NEED READBACK'\n            : 'MIDI ROUTE MAPPED - SESSION NOT CONFIRMED';\n      updateGaiaScreen({ connection: route });\n      after(1000, refresh);\n    }\n    refresh();\n  }\n  return { onPanelLoad };\n})();\nfunction onPanelLoad() { display.onPanelLoad(); }\n",
      "scope": "panel",
      "target": "*",
      "event": "onPanelLoad",
      "enabled": true,
      "description": "Read-only MIDI route status. LCD menu/source bindings handle patch, parameter, arp and system readouts.",
      "group": ""
    },
    {
      "id": "gaia_tone_copy",
      "name": "Copy tone with hardware readback",
      "language": "javascript",
      "source": "var gaiaToneCopy = (function installToneCopy(config) {\n  let job = null, serial = 0;\n  const role = config.role;\n  const routeKey = () => {\n    const p = ce.device.profile(role);\n    return p ? p.id + ':' + p.midiInput + ':' + p.midiDestination : '';\n  };\n  function status(text) { if (job) set('tone' + job.from + '_copy_status.text.content', text); }\n  function finish(text) { status(text); job = null; serial++; }\n  function send(command, address, data) {\n    const body = address.concat(data);\n    routeMidi(role, () => sendSysex([240,65,job.deviceId,0,0,65,command].concat(body, [(128-body.reduce((a,b)=>a+b,0)%128)%128,247])));\n  }\n  function wait(phase) {\n    job.phase = phase;\n    const token = ++serial;\n    after(2500, () => { if (job && token === serial) finish('No reply. Copy stopped.'); });\n  }\n  function read(tone, phase) { wait(phase); send(17, [16,0,tone,0], [0,0,0,62]); }\n  function begin(from, to) {\n    const profile = ce.device.profile(role);\n    if (!profile || profile.id !== 'roland-gaia-sh01') {\n      set('tone' + from + '_copy_status.text.content', 'Connect the GAIA first.'); return;\n    }\n    job = { from, to, route: routeKey() };\n    status('Reading Tone ' + from + '…');\n    wait('identity');\n    routeMidi(role, () => sendSysex([240,126,127,6,1,247]));\n  }\n  function choose(from) {\n    if (job || ![1,2,3].includes(from)) return;\n    const destinations = [1,2,3].filter(t => t !== from);\n    ce.ui.dialog({ title: 'Copy Tone ' + from + ' to…',\n      message: 'Replaces the destination tone in the current sound with a fresh read from the GAIA. Stored patches are unchanged until you save the patch.',\n      buttons: destinations.map(t => 'Tone ' + t).concat('Cancel'), default: 'Cancel',\n    }, choice => {\n      const to = destinations.find(t => choice === 'Tone ' + t);\n      if (to && !job) begin(from, to);\n    });\n  }\n  function receive(bytes) {\n    if (!job) return;\n    if (routeKey() !== job.route) { finish('Connection changed. Stopped.'); return; }\n    if (!Array.isArray(bytes)) return;\n    if (job.phase === 'identity') {\n      if (bytes.length !== 15 || bytes[0] !== 240 || bytes[1] !== 126 || bytes[3] !== 6 || bytes[4] !== 2\n        || bytes[5] !== 65 || bytes[6] !== 65 || bytes[7] !== 2 || bytes[8] !== 0 || bytes[9] !== 0 || bytes[14] !== 247) return;\n      job.deviceId = bytes[2]; read(job.from, 'source'); return;\n    }\n    if (bytes.length !== 75 || bytes[0] !== 240 || bytes[1] !== 65 || bytes[2] !== job.deviceId\n      || bytes[3] !== 0 || bytes[4] !== 0 || bytes[5] !== 65 || bytes[6] !== 18 || bytes[74] !== 247) return;\n    if (bytes.slice(1,-1).some(b => !Number.isInteger(b) || b < 0 || b > 127)\n      || bytes.slice(7,-1).reduce((a,b)=>a+b,0)%128 !== 0) return;\n    const tone = job.phase === 'source' ? job.from : job.to;\n    if (bytes.slice(7,11).join() !== [16,0,tone,0].join()) return;\n    const data = bytes.slice(11,-2);\n    if (job.phase === 'source') {\n      for (const field of config.fields) {\n        if (data[field.offset] < field.min || data[field.offset] > field.max) { finish('Invalid tone data. Stopped.'); return; }\n      }\n      job.source = data;\n      job.phase = 'writing'; serial++;\n      status('Copying to Tone ' + job.to + '…');\n      // Write documented fields only; destination reserved bytes are preserved.\n      for (const segment of config.segments) send(18, [16,0,job.to,segment.start], data.slice(segment.start, segment.end));\n      const token = serial;\n      after(100, () => {\n        if (!job || serial !== token) return;\n        if (routeKey() !== job.route) { finish('Connection changed. Stopped.'); return; }\n        read(job.to, 'verify');\n      });\n    } else if (job.phase === 'verify') {\n      if (config.fields.some(field => data[field.offset] !== job.source[field.offset])) { finish('Readback differs. Check tone.'); return; }\n      for (const t of [1,2,3]) ce.device.write('common.tone' + t + 'Select', t === job.to ? 'on' : 'off', role);\n      send(17, [16,0,0,0], [0,0,0,61]);\n      finish('Copied to Tone ' + job.to);\n    }\n  }\n  function load() {\n    job = null; serial++;\n    defineAction('gaiaToneCopy', choose);\n    on('*', 'onSysexIn', receive);\n    on('*', 'onDeviceDisconnected', event => { if (job && event.role === role) finish('Disconnected. Copy stopped.'); });\n    on('*', 'onPresetChange', event => { if (job && event.role === role) finish('Patch changed. Copy stopped.'); });\n  }\n  return { load, receive };\n})({\"role\":\"Roland GAIA SH-01\",\"fields\":[{\"offset\":0,\"min\":0,\"max\":6},{\"offset\":1,\"min\":0,\"max\":2},{\"offset\":3,\"min\":40,\"max\":88},{\"offset\":4,\"min\":14,\"max\":114},{\"offset\":5,\"min\":0,\"max\":127},{\"offset\":6,\"min\":0,\"max\":127},{\"offset\":7,\"min\":0,\"max\":127},{\"offset\":8,\"min\":0,\"max\":127},{\"offset\":9,\"min\":1,\"max\":127},{\"offset\":10,\"min\":0,\"max\":4},{\"offset\":11,\"min\":0,\"max\":1},{\"offset\":12,\"min\":0,\"max\":127},{\"offset\":13,\"min\":54,\"max\":74},{\"offset\":14,\"min\":1,\"max\":127},{\"offset\":15,\"min\":0,\"max\":127},{\"offset\":16,\"min\":0,\"max\":127},{\"offset\":17,\"min\":0,\"max\":127},{\"offset\":18,\"min\":0,\"max\":127},{\"offset\":19,\"min\":0,\"max\":127},{\"offset\":20,\"min\":1,\"max\":127},{\"offset\":21,\"min\":0,\"max\":127},{\"offset\":22,\"min\":1,\"max\":127},{\"offset\":23,\"min\":0,\"max\":127},{\"offset\":24,\"min\":0,\"max\":127},{\"offset\":25,\"min\":0,\"max\":127},{\"offset\":26,\"min\":0,\"max\":127},{\"offset\":27,\"min\":0,\"max\":127},{\"offset\":28,\"min\":0,\"max\":5},{\"offset\":29,\"min\":0,\"max\":127},{\"offset\":30,\"min\":0,\"max\":1},{\"offset\":31,\"min\":0,\"max\":19},{\"offset\":32,\"min\":0,\"max\":127},{\"offset\":33,\"min\":0,\"max\":1},{\"offset\":34,\"min\":1,\"max\":127},{\"offset\":35,\"min\":1,\"max\":127},{\"offset\":36,\"min\":1,\"max\":127},{\"offset\":37,\"min\":1,\"max\":127},{\"offset\":38,\"min\":0,\"max\":5},{\"offset\":39,\"min\":0,\"max\":127},{\"offset\":40,\"min\":0,\"max\":1},{\"offset\":41,\"min\":0,\"max\":19},{\"offset\":44,\"min\":1,\"max\":127},{\"offset\":45,\"min\":1,\"max\":127},{\"offset\":46,\"min\":1,\"max\":127},{\"offset\":47,\"min\":1,\"max\":127}],\"segments\":[{\"start\":0,\"end\":2},{\"start\":3,\"end\":42},{\"start\":44,\"end\":48}]});\nfunction onPanelLoad() { gaiaToneCopy.load(); }\nfunction onSysexIn(bytes) { gaiaToneCopy.receive(bytes); }\n",
      "scope": "panel",
      "target": "*",
      "event": "onPanelLoad",
      "enabled": true,
      "description": "",
      "group": ""
    },
    {
      "id": "gaia_tone1_copy_click",
      "name": "Copy Tone 1",
      "language": "javascript",
      "source": "function onClick() { run('gaiaToneCopy', 1); }",
      "scope": "panel",
      "target": "tone1_copy",
      "event": "onClick",
      "enabled": true,
      "description": "",
      "group": ""
    },
