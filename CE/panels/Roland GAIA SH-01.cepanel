                    "gaia_lbl_619": {
                      "_children": {
                        "Core": {
                          "name": "arp_octaveRange_caption",
                          "tooltip": "Octave cycling from -3 to +3. Zero keeps the played octave range; positive values extend upward, negative values downward. This does not transpose the stored note blocks.\nThese performance controls send live; only note blocks and END STEP use Send Pattern.",
                          "id": "gaia_lbl_619",
                          "controlType": "Label"
                        },
                        "Transform": {
                          "x": 112,
                          "y": 174.89285714285714,
