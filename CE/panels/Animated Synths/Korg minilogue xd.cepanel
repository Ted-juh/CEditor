        "Value": {"rows":[{"id":"sqr","displayText":"SQR","internalValue":"sqr","sendValue":0,"receiveValue":0,"selectedByDefault":true},{"id":"tri","displayText":"TRI","internalValue":"tri","sendValue":64,"receiveValue":64},{"id":"saw","displayText":"SAW","internalValue":"saw","sendValue":127,"receiveValue":127}]}
