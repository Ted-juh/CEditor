{
  "schemaVersion": 1,
  "profileVersion": "1.0.0",
  "minCEditorVersion": "0.9.0",
  "id": "test-cc-synth",
  "name": "Test CC Synth",
  "manufacturer": "CEditor",
  "family": "Internal Test",
  "status": "experimental",
  "trust": "local",
  "variables": {
    "channel": 1
  },
  "coverage": {
    "singleParameterWrite": "complete",
    "realtimeEditing": "complete"
  },
  "timing": {
    "minDelayBetweenMessagesMs": 0
  },
  "parameters": [
    {
      "id": "filter.cutoff",
      "name": "Filter Cutoff",
      "group": "Filter",
      "type": "integer",
      "range": { "min": 0, "max": 127 },
      "default": 64,
      "display": { "mode": "number", "unit": "", "shortLabel": "Cutoff" },
      "normalization": { "mode": "linear" },
      "encoding": { "type": "u7" },
      "access": {
        "canRead": true,
        "canWrite": true,
        "realtimeSafe": true,
        "source": "singleParameter",
        "dumpReadable": false,
        "requiresConfirmation": false
      },
      "sendPolicy": {
        "mode": "continuous",
        "coalesce": true,
        "minIntervalMs": 20,
        "sendFinalOnRelease": true
      },
      "messageRecipe": "cutoffCc",
      "ui": { "preferredComponent": "Slider" }
    },
    {
      "id": "filter.resonance",
      "name": "Filter Resonance",
      "group": "Filter",
      "type": "integer",
      "range": { "min": 0, "max": 127 },
      "default": 32,
      "display": { "mode": "number", "unit": "", "shortLabel": "Res" },
      "normalization": { "mode": "linear" },
      "encoding": { "type": "u7" },
      "access": {
        "canRead": true,
        "canWrite": true,
        "realtimeSafe": true,
        "source": "singleParameter"
      },
      "sendPolicy": {
        "mode": "continuous",
        "coalesce": true,
        "minIntervalMs": 0,
        "sendFinalOnRelease": true
      },
      "messageRecipe": "resonanceCc",
      "ui": { "preferredComponent": "Slider" }
    },
    {
      "id": "osc.waveform",
      "name": "Oscillator Waveform",
      "group": "Oscillator",
      "type": "choice",
      "default": "saw",
      "choices": [
        { "id": "saw", "label": "Saw", "value": 0 },
        { "id": "square", "label": "Square", "value": 1 },
        { "id": "triangle", "label": "Triangle", "value": 2 }
      ],
      "display": { "mode": "choice", "shortLabel": "Wave" },
      "normalization": { "mode": "choiceIndex" },
      "encoding": { "type": "enum" },
      "access": {
        "canRead": true,
        "canWrite": true,
        "realtimeSafe": true,
        "source": "singleParameter"
      },
      "sendPolicy": {
        "mode": "onCommit",
        "coalesce": true
      },
      "messageRecipe": "waveformCc",
      "ui": { "preferredComponent": "Combobox" }
    }
  ],
  "messageRecipes": [
    {
      "id": "cutoffCc",
      "kind": "cc",
      "channel": "$channel",
      "controller": 74,
      "value": "$encodedValue"
    },
    {
      "id": "resonanceCc",
      "kind": "cc",
      "channel": "$channel",
      "controller": 71,
      "value": "$encodedValue"
    },
    {
      "id": "waveformCc",
      "kind": "cc",
      "channel": "$channel",
      "controller": 80,
      "value": "$encodedValue"
    }
  ],
  "tests": [
    {
      "name": "Filter Cutoff 64",
      "parameter": "filter.cutoff",
      "value": 64,
      "expectedHex": "B0 4A 40"
    },
    {
      "name": "Filter Resonance 32",
      "parameter": "filter.resonance",
      "value": 32,
      "expectedHex": "B0 47 20"
    },
    {
      "name": "Waveform Square",
      "parameter": "osc.waveform",
      "value": "square",
      "expectedHex": "B0 50 01"
    }
  ],
  "sources": [
    {
      "type": "internal",
      "title": "CEditor Test CC Synth",
      "notes": "Synthetic profile for Device Profile Engine tests."
    }
  ],
