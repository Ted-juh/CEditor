  "id": "moog-claravox-centennial",
  "name": "Moog Claravox Centennial",
  "manufacturer": "Moog",
  "family": "Claravox",
  "status": "experimental",
  "trust": "local",
  "description": "Moog Claravox Centennial theremin: the MIDI parameter tables of its user guide, the 14-bit settings on their NRPNs and the rest on their CCs.",
  "sources": [
    {
      "type": "manual",
      "title": "Claravox Centennial User Guide",
      "notes": "MIDI CC table (pages 56, 57, 58, 59, 60, 61, 62, 63) read by tools/profiles/moog/read-moog-pdf.mjs from Claravox_Centennial_Web_Manual.pdf (sha256 5267c36907ac8d059cca8af84aba764ba3a07bbd7593f2454c724c0e9f234ebc), https://cdn.inmusicbrands.com/Moog/BackOffice/Claravox_Centennial_Web_Manual.pdf. Not yet checked against the instrument itself."
    }
  ],
  "testedWith": [],
  "authoringNotes": [
    "Generated by tools/profiles/moog/make-profiles.mjs; edit the layout in tools/profiles/moog/synths/, not this file.",
    "Every parameter is a row of the manual's MIDI tables, with its printed name. Nothing here has been sent to a real instrument yet.",
    "No identity check: the manual prints no Device Inquiry reply.",
    "The Quantize (ROOT) names are C♯ (D♭) and so on: the guide's ♯ and ♭ are in a font whose signs the PDF's text leaves out (`C (D )`), and are restored here.",
    "Every row prints a CC and an NRPN. A range of 0 - 16383 is sent on the NRPN, as one 14-bit value; the rest, 0 - 127 or named values, on the CC.",
    "Each NRPN is sent with its number split as MIDI splits one (MSB n / 128, LSB n % 128) and its value as one 14-bit number, data entry MSB on CC 6 then LSB on CC 38."
  ],
  "variables": {
    "channel": 1
  },
  "coverage": {
    "singleParameterWrite": "complete-for-the-manual's-midi-tables",
    "realtimeEditing": "complete-for-the-manual's-midi-tables",
    "editBufferDumpRequest": "notImplemented",
    "editBufferDumpParse": "notImplemented",
    "bankDump": "notImplemented",
    "inboundControllers": "the panel sends these same messages when its MIDI settings allow",
    "verifiedOnHardware": false
  },
  "timing": {
    "minDelayBetweenMessagesMs": 0
  },
