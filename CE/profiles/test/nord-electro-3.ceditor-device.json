  "id": "nord-electro-3",
  "name": "Nord Electro 3",
  "manufacturer": "Nord",
  "family": "Electro",
  "status": "experimental",
  "trust": "local",
  "description": "Nord Electro 3 stage keyboard: every control of its manual's MIDI controller list.",
  "sources": [
    {
      "type": "manual",
      "title": "Nord Electro 3 User Manual, OS v3.x, Edition 3.1",
      "notes": "MIDI controller list (page 25 of the PDF) read by tools/profiles/nord/read-nord-cc.mjs from Nord Electro 3 English User Manual v3.x Edition 3.1.pdf (sha256 4bed0798ad9f022cd66b157c5889af3ff8fa304b898e66912b09666be7311ab1), https://www.nordkeyboards.com/wt/documents/200/Nord%20Electro%203%20English%20User%20Manual%20v3.x%20Edition%203.1.pdf. Not yet checked against the instrument itself."
    }
  ],
  "testedWith": [],
  "authoringNotes": [
    "Generated by tools/profiles/nord/make-profiles.mjs; edit the layout in tools/profiles/nord/synths/, not this file.",
    "Every parameter is a row of the manual's MIDI controller list, with its printed name, sent as the control change it prints on the channel variable. Nothing here has been sent to a real instrument yet.",
    "The list prints controller numbers only: every value is 0 - 127, and a setting chosen from a list (a model, a waveform, an effect type) is a number here, not a choice.",
    "Rows the list marks Electro 3 HP only are laid out, the marking kept in their names.",
    "Messages the list gives to two rows, both laid out: CC 117: Vib On/Off Preset 1/LOW (B3 model), EQ Mid Freq. CEditor sends either, and follows neither when the instrument sends it.",
    "Left out, the pedals, the wheel and bank select: 64 Sustain Pedal, 11 Control Pedal."
  ],
  "variables": {
    "channel": 1
  },
  "coverage": {
    "singleParameterWrite": "complete-for-the-manual's-MIDI-controller-list",
    "realtimeEditing": "complete-for-the-manual's-MIDI-controller-list",
    "editBufferDumpRequest": "notImplemented",
    "editBufferDumpParse": "notImplemented",
    "bankDump": "notImplemented",
    "inboundControllers": "the instrument sends these same messages when its panel is used, where its MIDI settings allow",
    "verifiedOnHardware": false
  },
  "timing": {
    "minDelayBetweenMessagesMs": 0
  },
