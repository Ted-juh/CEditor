{
  "schemaVersion": 1,
  "profileVersion": "1.0.0",
  "minCEditorVersion": "0.9.0",
  "id": "test-sysex-synth",
  "name": "Test SysEx Synth",
  "manufacturer": "CEditor",
  "family": "Internal Test",
  "status": "experimental",
  "trust": "local",
  "variables": {
    "deviceId": 16
  },
  "identity": {
    "requestDeviceId": "$deviceId",
    "manufacturerId": ["7D"],
    "familyCode": ["00", "01"],
    "modelNumber": ["00", "02"],
    "revision": ["00", "00", "00", "01"],
    "timeoutMs": 1000,
    "retries": 0
  },
  "coverage": {
    "singleParameterWrite": "complete",
    "editBufferDumpParse": "partial",
    "realtimeEditing": "partial"
  },
  "timing": {
    "minDelayBetweenMessagesMs": 20
  },
  "parameters": [
    {
      "id": "filter.cutoff",
      "name": "Filter Cutoff",
      "group": "Filter",
      "type": "integer",
      "range": { "min": 0, "max": 127 },
      "default": 64,
      "address": "20",
      "display": { "mode": "number", "unit": "", "shortLabel": "Cutoff" },
      "normalization": { "mode": "linear" },
      "encoding": { "type": "u7" },
      "access": {
        "canRead": true,
        "canWrite": true,
        "realtimeSafe": true,
        "source": "singleParameter",
        "dumpReadable": true,
        "requiresConfirmation": false
      },
      "sendPolicy": {
        "mode": "continuous",
        "coalesce": true,
        "minIntervalMs": 20,
        "sendFinalOnRelease": true
      },
      "messageRecipe": "singleParameterWrite",
      "ui": { "preferredComponent": "Slider" }
    },
    {
      "id": "osc.waveform",
      "name": "Oscillator Waveform",
      "group": "Oscillator",
      "type": "choice",
      "default": "saw",
      "address": "21",
      "choices": [
        { "id": "saw", "label": "Saw", "value": 0 },
        { "id": "square", "label": "Square", "value": 1 },
        { "id": "triangle", "label": "Triangle", "value": 2 }
      ],
      "display": { "mode": "choice", "shortLabel": "Wave" },
      "normalization": { "mode": "choiceIndex" },
      "encoding": { "type": "enum" },
      "access": {
        "canRead": true,
        "canWrite": true,
        "realtimeSafe": true,
        "source": "singleParameter",
        "dumpReadable": true
      },
      "sendPolicy": {
        "mode": "onCommit",
        "coalesce": true
      },
      "messageRecipe": "singleParameterWrite",
      "ui": { "preferredComponent": "Combobox" }
    },
    {
      "id": "mod.depth",
      "name": "Mod Depth",
      "group": "Modulation",
      "type": "integer",
      "range": { "min": 0, "max": 255 },
      "default": 0,
      "address": "22",
      "display": { "mode": "number", "unit": "", "shortLabel": "Depth" },
      "normalization": { "mode": "linear" },
      "encoding": { "type": "u7" },
      "access": {
        "canRead": true,
        "canWrite": true,
        "realtimeSafe": true,
        "source": "singleParameter",
        "dumpReadable": true
      },
      "sendPolicy": {
        "mode": "continuous",
        "coalesce": true,
        "minIntervalMs": 20,
        "sendFinalOnRelease": true
      },
      "messageRecipe": "singleParameterWrite",
      "ui": { "preferredComponent": "Slider" }
    },
    {
      "id": "lfo.pan",
      "name": "LFO Pan",
      "group": "LFO",
      "type": "integer",
      "range": { "min": -64, "max": 63 },
      "default": 0,
      "address": "23",
      "display": { "mode": "number", "unit": "", "shortLabel": "Pan" },
      "normalization": { "mode": "linear" },
      "encoding": { "type": "s7", "signedOffset": 64 },
      "access": {
        "canRead": true,
        "canWrite": true,
        "realtimeSafe": true,
        "source": "singleParameter",
        "dumpReadable": true
      },
      "sendPolicy": {
        "mode": "continuous",
        "coalesce": true,
        "minIntervalMs": 20,
        "sendFinalOnRelease": true
      },
      "messageRecipe": "singleParameterWrite",
      "ui": { "preferredComponent": "Slider" }
    },
    {
      "id": "preset.name",
      "name": "Preset Name",
      "group": "Preset",
      "type": "text",
      "default": "",
      "display": { "mode": "text", "shortLabel": "Name" },
      "encoding": { "type": "text-ascii", "length": 7, "pad": 32 },
      "access": {
        "canRead": true,
        "canWrite": false,
        "dumpReadable": true
      },
      "ui": { "preferredComponent": "Label" }
    },
    {
      "id": "preset.packedName",
      "name": "Packed Preset Name",
      "group": "Preset",
      "type": "text",
      "default": "",
      "display": { "mode": "text", "shortLabel": "Packed" },
      "encoding": { "type": "text-nibbled-ascii", "length": 3, "pad": 32 },
      "access": {
        "canRead": true,
        "canWrite": false,
        "dumpReadable": true
      },
      "ui": { "preferredComponent": "Label" }
    }
  ],
  "messageRecipes": [
    {
      "id": "singleParameterWrite",
      "kind": "sysex",
      "template": [
        "F0",
        "7D",
        "$deviceId",
        "$address",
        "$encodedValue",
        "$checksum",
        "F7"
      ],
      "checksum": {
        "type": "sum-7bit",
        "from": "$address",
        "to": "$encodedValue"
      }
    }
  ],
  "requests": [
    {
      "id": "identityRequest",
      "name": "Identity Request",
      "kind": "sysex",
      "template": ["F0", "7E", "$deviceId", "06", "01", "F7"],
      "response": { "kind": "identity" },
      "timeoutMs": 1000,
      "retries": 0
    },
    {
      "id": "requestCurrentPatchDump",
      "name": "Request Current Patch Dump",
      "kind": "sysex",
      "template": ["F0", "7D", "$deviceId", "00", "01", "F7"],
      "response": { "dump": "currentPatchDump" },
      "timeoutMs": 2000,
      "retries": 1
    },
    {
      "id": "requestPresetName",
      "name": "Request Preset Name",
      "kind": "sysex",
      "template": ["F0", "7D", "$deviceId", "02", "$slot", "F7"],
      "response": { "dump": "presetNameDump" },
      "timeoutMs": 2000,
      "retries": 1
    },
    {
      "id": "requestSplitPatchDump",
      "name": "Request Split Patch Dump",
      "kind": "sysex",
      "template": ["F0", "7D", "$deviceId", "07", "F7"],
      "response": { "dump": "splitPatchCutoffDump", "continueRequest": "requestSplitPatchContinue" },
      "timeoutMs": 2000,
      "retries": 1
    },
    {
      "id": "requestSplitPatchContinue",
      "name": "Continue Split Patch Dump",
      "kind": "sysex",
      "template": ["F0", "7D", "$deviceId", "08", "F7"],
      "response": { "dump": "splitPatchWaveformDump" },
      "timeoutMs": 2000,
      "retries": 1
    }
  ],
  "startup": {
    "policy": "pull",
    "syncDirection": "pull",
    "sync": [
      { "request": "identityRequest" },
      { "request": "requestCurrentPatchDump" }
    ]
  },
  "presetBrowser": {
    "request": "requestPresetName",
    "slotVariable": "slot",
    "slots": [1, 2, 3]
  },
  "presets": {
    "banks": [
      {
        "id": "factory",
        "label": "Factory",
        "role": "factory",
        "startSlot": 1,
        "slotCount": 2,
        "programBase": 0,
        "bankMsb": 0,
        "bankLsb": 0,
        "names": ["Init Pad", "Init Lead"]
      },
      {
        "id": "user",
        "label": "User",
        "role": "user",
        "writable": true,
        "startSlot": 3,
        "slotCount": 1,
        "programBase": 2,
        "bankMsb": 0,
        "bankLsb": 1
      }
    ],
    "recall": { "kind": "bankPc" },
    "nameRequest": { "request": "requestPresetName", "slotVariable": "slot" },
    "initPatch": { "bank": "factory", "slot": 1 }
  },
  "dumpDefinitions": [
    {
      "id": "presetNameDump",
      "name": "Preset Name Dump",
      "kind": "sysex",
      "matcher": {
        "prefix": ["F0", "7D", "$deviceId", "03"],
        "suffix": ["F7"]
      },
      "payload": {
        "offset": 4,
        "size": 8
      },
      "completion": {
        "expectedMessages": 1,
        "expectedBytes": 13,
        "byteRanges": [
          { "label": "slot", "offset": 4, "length": 1 },
          { "label": "name", "offset": 5, "length": 7, "codec": "text-ascii" }
        ]
      },
      "mappings": [
        { "parameter": "preset.name", "offset": 1, "codec": { "type": "text-ascii", "length": 7, "pad": 32 } }
      ]
    },
    {
      "id": "currentPatchDump",
      "name": "Current Patch Dump",
      "kind": "sysex",
      "matcher": {
        "prefix": ["F0", "7D", "$deviceId", "01"],
        "suffix": ["F7"]
      },
      "payload": {
        "offset": 4
      },
      "completion": {
        "expectedMessages": 1,
        "expectedBytes": 8,
        "byteRanges": [
          { "label": "patch-values", "offset": 4, "length": 2 }
        ]
      },
      "checksum": {
        "type": "sum-7bit",
        "fromOffset": 3,
        "toOffset": 5,
        "byteOffset": 6
      },
      "mappings": [
        { "parameter": "filter.cutoff", "offset": 0 },
        { "parameter": "osc.waveform", "offset": 1 }
      ]
    },
    {
      "id": "packedPresetNameDump",
      "name": "Packed Preset Name Dump",
      "kind": "sysex",
      "matcher": {
        "prefix": ["F0", "7D", "$deviceId", "04"],
        "suffix": ["F7"]
      },
      "payload": {
        "offset": 4,
        "size": 6
      },
      "completion": {
        "expectedMessages": 1,
        "expectedBytes": 11,
        "byteRanges": [
          { "label": "packed-name", "offset": 4, "length": 6, "codec": "text-nibbled-ascii" }
        ]
      },
      "mappings": [
        {
          "parameter": "preset.packedName",
          "offset": 0,
          "codec": { "type": "text-nibbled-ascii", "length": 3, "pad": 32 }
        }
      ]
    },
    {
      "id": "unsupportedNameDump",
      "name": "Unsupported Name Dump",
      "kind": "sysex",
      "matcher": {
        "prefix": ["F0", "7D", "$deviceId", "05"],
        "suffix": ["F7"]
      },
      "payload": {
        "offset": 4,
        "size": 2
      },
      "completion": {
        "expectedMessages": 1,
        "expectedBytes": 7
      },
      "mappings": [
        {
          "parameter": "preset.name",
          "offset": 0,
          "codec": { "type": "unsupported-name-codec", "length": 2 }
        }
      ]
    },
    {
      "id": "splitPatchCutoffDump",
      "name": "Split Patch Cutoff Dump",
      "kind": "sysex",
      "matcher": {
        "prefix": ["F0", "7D", "$deviceId", "06", "00"],
        "suffix": ["F7"]
      },
      "payload": {
        "offset": 5,
        "size": 1
      },
      "completion": {
        "collectionId": "splitPatchDump",
        "expectedMessages": 2,
        "expectedBytes": 7,
        "collectionBytes": 2,
        "addressRange": { "label": "cutoff", "start": 0, "length": 1 }
      },
      "mappings": [
        { "parameter": "filter.cutoff", "offset": 0 }
      ]
    },
    {
      "id": "splitPatchWaveformDump",
      "name": "Split Patch Waveform Dump",
      "kind": "sysex",
      "matcher": {
        "prefix": ["F0", "7D", "$deviceId", "06", "01"],
        "suffix": ["F7"]
      },
      "payload": {
        "offset": 5,
        "size": 1
      },
      "completion": {
        "collectionId": "splitPatchDump",
        "expectedMessages": 2,
        "expectedBytes": 7,
        "collectionBytes": 2,
        "addressRange": { "label": "waveform", "start": 1, "length": 1 }
      },
      "mappings": [
        { "parameter": "osc.waveform", "offset": 0 }
      ]
    },
    {
      "id": "packedPayloadDump",
      "name": "Packed Payload Dump",
      "kind": "sysex",
      "matcher": {
        "prefix": ["F0", "7D", "$deviceId", "08"],
        "suffix": ["F7"]
      },
      "payload": {
        "offset": 4,
        "size": 2,
        "pack": { "type": "packed8to7", "packOrder": "msb-high-first", "groupSize": 7 }
      },
      "completion": {
        "expectedMessages": 1,
        "expectedBytes": 8
      },
      "mappings": [
        { "parameter": "filter.cutoff", "offset": 0 },
        { "parameter": "mod.depth", "offset": 1 }
      ]
    },
    {
      "id": "xorPatchDump",
      "name": "XOR Patch Dump",
      "kind": "sysex",
      "matcher": {
        "prefix": ["F0", "7D", "$deviceId", "09"],
        "suffix": ["F7"]
      },
      "payload": {
        "offset": 4,
        "size": 2
      },
      "checksum": {
        "type": "xor",
        "fromOffset": 3,
        "toOffset": 5,
        "byteOffset": 6
      },
      "completion": {
        "expectedMessages": 1,
        "expectedBytes": 8
      },
      "mappings": [
        { "parameter": "filter.cutoff", "offset": 0 },
        { "parameter": "osc.waveform", "offset": 1 }
      ]
    },
    {
      "id": "s7PatchDump",
      "name": "Signed (s7) Patch Dump",
      "kind": "sysex",
      "matcher": {
        "prefix": ["F0", "7D", "$deviceId", "0A"],
        "suffix": ["F7"]
      },
      "payload": {
        "offset": 4,
        "size": 1
      },
      "completion": {
        "expectedMessages": 1,
        "expectedBytes": 6
      },
      "mappings": [
        { "parameter": "lfo.pan", "offset": 0, "codec": { "type": "s7", "signedOffset": 64 } }
      ]
    },
    {
      "id": "u14LsbDump",
      "name": "14-bit LSB-first Dump",
      "kind": "sysex",
      "matcher": {
        "prefix": ["F0", "7D", "$deviceId", "0B"],
        "suffix": ["F7"]
      },
      "payload": {
        "offset": 4,
        "size": 2
      },
      "completion": {
        "expectedMessages": 1,
        "expectedBytes": 7
      },
      "mappings": [
        { "parameter": "mod.depth", "offset": 0, "codec": { "type": "u14-lsb-msb" } }
      ]
    }
  ],
  "tests": [
    {
      "name": "Universal Identity Request",
      "kind": "identityRequest",
      "expectedHex": "F0 7E 10 06 01 F7"
    },
    {
      "name": "Universal Identity Reply",
      "kind": "identityReply",
      "inputHex": "F0 7E 10 06 02 7D 00 01 00 02 00 00 00 01 F7",
      "expectedValues": {
        "identity.deviceId": "10",
        "identity.manufacturerId": "7D",
        "identity.familyCode": "00 01",
        "identity.modelNumber": "00 02",
        "identity.revision": "00 00 00 01"
      }
    },
    {
      "name": "Filter Cutoff 64",
      "parameter": "filter.cutoff",
      "value": 64,
      "expectedHex": "F0 7D 10 20 40 60 F7"
    },
    {
      "name": "Waveform Triangle",
      "parameter": "osc.waveform",
      "value": "triangle",
      "expectedHex": "F0 7D 10 21 02 23 F7"
    },
    {
      "name": "Request Current Patch Dump",
      "kind": "request",
      "request": "requestCurrentPatchDump",
      "expectedHex": "F0 7D 10 00 01 F7"
    },
    {
      "name": "Request Preset Name 3",
      "kind": "request",
      "request": "requestPresetName",
      "variables": { "slot": 3 },
      "expectedHex": "F0 7D 10 02 03 F7"
    },
    {
      "name": "Request Split Patch Dump",
      "kind": "request",
      "request": "requestSplitPatchDump",
      "expectedHex": "F0 7D 10 07 F7"
    },
    {
      "name": "Parse Preset Name Dump",
      "kind": "dumpParse",
      "inputHex": "F0 7D 10 03 03 50 61 64 20 30 30 33 F7",
      "expectedValues": {
        "preset.name": "Pad 003"
      }
    },
    {
      "name": "Parse Packed Preset Name Dump",
      "kind": "dumpParse",
      "inputHex": "F0 7D 10 04 05 00 06 01 06 04 F7",
      "expectedValues": {
        "preset.packedName": "Pad"
      }
    },
    {
      "name": "Parse Current Patch Dump",
      "kind": "dumpParse",
      "inputHex": "F0 7D 10 01 40 02 43 F7",
      "expectedValues": {
        "filter.cutoff": 64,
        "osc.waveform": "triangle"
      }
    }
  ],
  "sources": [
    {
      "type": "internal",
      "title": "CEditor Test SysEx Synth",
      "notes": "Synthetic profile for Device Profile Engine SysEx tests."
    }
  ],
  "testedWith": []
}
