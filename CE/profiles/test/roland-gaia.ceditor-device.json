  "messageRecipes": [
    {
      "id": "dt1",
      "kind": "sysex",
      "template": ["F0", "41", "$deviceId", "00", "00", "41", "12", "$address", "$encodedValue", "$checksum", "F7"],
      "checksum": { "type": "roland-7bit", "from": "$address", "to": "$encodedValue" },
      "delayAfterMs": 20
    },
    {
      "id": "rq1",
      "kind": "sysex",
      "template": ["F0", "41", "$deviceId", "00", "00", "41", "11", "$address", "$size", "$checksum", "F7"],
      "checksum": { "type": "roland-7bit", "from": "$address", "to": "$size" },
      "delayAfterMs": 20
    },
    {
      "id": "volumeCc",
      "kind": "cc",
      "channel": "$channel",
      "controller": 7,
      "value": "$encodedValue"
    }
  ],
  "requests": [
    {
      "id": "identityRequest",
      "name": "Identity Request",
      "kind": "sysex",
      "template": ["F0", "7E", "$deviceId", "06", "01", "F7"],
      "response": { "kind": "identity" },
      "timeoutMs": 1000,
      "retries": 0
    }
  ],
  "startup": {
    "policy": "pull",
    "syncDirection": "pull",
    "sync": [
      { "request": "identityRequest" }
    ]
  },
  "tests": [
    {
      "name": "Universal Identity Request",
      "kind": "identityRequest",
      "expectedHex": "F0 7E 7F 06 01 F7"
    },
    {
      "name": "Identity Reply (GAIA SH-01)",
      "kind": "identityReply",
      "inputHex": "F0 7E 10 06 02 41 41 02 00 00 00 03 00 00 F7",
      "expectedValues": {
        "identity.deviceId": "10",
        "identity.manufacturerId": "41",
        "identity.familyCode": "41 02",
        "identity.modelNumber": "00 00",
        "identity.revision": "00 03 00 00"
      }
    },
    {
      "name": "Filter Mode LPF",
      "parameter": "filter.mode",
      "value": "lpf",
      "expectedHex": "F0 41 7F 00 00 41 12 10 00 01 0A 01 64 F7"
    },
    {
      "name": "Filter Slope -24 dB",
      "parameter": "filter.slope",
      "value": "db24",
      "expectedHex": "F0 41 7F 00 00 41 12 10 00 01 0B 01 63 F7"
    },
    {
      "name": "Filter Cutoff 64",
      "parameter": "filter.cutoff",
      "value": 64,
      "expectedHex": "F0 41 7F 00 00 41 12 10 00 01 0C 40 23 F7"
    },
    {
      "name": "Filter Cutoff Keyfollow 64",
      "parameter": "filter.cutoffKeyfollow",
      "value": 64,
      "expectedHex": "F0 41 7F 00 00 41 12 10 00 01 0D 40 22 F7"
    },
    {
      "name": "Filter Env Velocity Sens 64",
      "parameter": "filter.envVelocitySens",
      "value": 64,
      "expectedHex": "F0 41 7F 00 00 41 12 10 00 01 0E 40 21 F7"
    },
    {
      "name": "Filter Resonance 32",
      "parameter": "filter.resonance",
      "value": 32,
      "expectedHex": "F0 41 7F 00 00 41 12 10 00 01 0F 20 40 F7"
    },
    {
      "name": "Filter Env Attack 0",
      "parameter": "filter.envAttack",
      "value": 0,
      "expectedHex": "F0 41 7F 00 00 41 12 10 00 01 10 00 5F F7"
    },
    {
      "name": "Filter Env Decay 127",
      "parameter": "filter.envDecay",
      "value": 127,
      "expectedHex": "F0 41 7F 00 00 41 12 10 00 01 11 7F 5F F7"
    },
    {
      "name": "Filter Env Sustain 100",
      "parameter": "filter.envSustain",
      "value": 100,
      "expectedHex": "F0 41 7F 00 00 41 12 10 00 01 12 64 79 F7"
    },
    {
      "name": "Filter Env Release 64",
      "parameter": "filter.envRelease",
      "value": 64,
      "expectedHex": "F0 41 7F 00 00 41 12 10 00 01 13 40 1C F7"
    },
    {
      "name": "Filter Env Depth 64",
      "parameter": "filter.envDepth",
      "value": 64,
      "expectedHex": "F0 41 7F 00 00 41 12 10 00 01 14 40 1B F7"
    },
    {
      "name": "Amp Level 100",
      "parameter": "amp.level",
      "value": 100,
      "expectedHex": "F0 41 7F 00 00 41 12 10 00 01 15 64 76 F7"
    },
    {
      "name": "Master Volume CC7 100",
      "parameter": "master.volume",
      "value": 100,
      "expectedHex": "B0 07 64"
    }
  ],
  "sources": [
    {
      "type": "manual",
      "title": "Roland SH-01 GAIA MIDI Implementation (v1.01, Sep 2010)",
      "notes": "Model ID 00 00 41, DT1=12 / RQ1=11, roland-7bit checksum. Filter section = Temporary Patch (10 00 00 00) Tone 1 (offset 00 01 00), parameter offsets 0A-15."
    }
  ],
