    },
    {
      "name": "Osc Pitch Center NRPN14",
      "parameter": "osc.pitch",
      "value": 8192,
      "expectedHex": "B0 63 02\nB0 62 10\nB0 06 40\nB0 26 00"
    },
    {
      "name": "Pitch Bend Range 2 RPN7 (101/100, then the null)",
      "parameter": "global.bendRange",
