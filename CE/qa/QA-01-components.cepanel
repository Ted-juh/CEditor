              "_type": "State",
              "name": "Focused",
              "group": "interaction",
              "description": "Accent the active pointer while focused.",
              "enabled": true,
              "when": {
                "focused": true
              },
              "patches": {
                "component": {},
                "parts": {
                  "pointerCurrent": {
                    "Background.Border.colour": "FF89C2FF"
                  },
                  "labelValue": {
                    "Text.Fill.colour": "FFDAEEFF"
                  }
                }
              }
            },
