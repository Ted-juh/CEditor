              "_type": "State",
              "name": "ActiveHandleStart",
              "group": "logical",
              "description": "Emphasize the start handle when it is active.",
              "enabled": true,
              "when": {
                "activeHandle": "start"
              },
              "patches": {
                "component": {},
                "parts": {
                  "pointerStart": {
                    "Layout.scale": 1.08
                  }
                }
