          "_type": "States",
          "enabled": true,
          "debug": false,
          "priority": [
            "hover",
            "focused",
            "dragging",
            "pressed",
            "disabled"
          ],
          "_children": {
            "Hover": {
              "_type": "State",
              "name": "Hover",
              "group": "interaction",
              "description": "Lift the step buttons and value field while hovering.",
              "enabled": true,
              "when": {
                "hover": true
              },
              "patches": {
                "component": {},
                "parts": {
                  "decrement": {
                    "Background.Fill.colour": "FF3D3D3D"
                  },
                  "increment": {
                    "Background.Fill.colour": "FF3D3D3D"
                  },
                  "valueField": {
                    "Background.Fill.colour": "FF1B1B1B"
                  }
                }
              }
            },
            "Pressed": {
              "_type": "State",
              "name": "Pressed",
              "group": "interaction",
              "description": "Tighten the control while pressing.",
              "enabled": true,
              "when": {
                "pressed": true
              },
              "patches": {
                "component": {
                  "Transform.scale": 0.99
                },
                "parts": {
                  "decrement": {
                    "Background.Fill.colour": "FF282828"
                  },
                  "increment": {
                    "Background.Fill.colour": "FF282828"
                  }
                }
              }
            },
            "Dragging": {
              "_type": "State",
              "name": "Dragging",
              "group": "interaction",
              "description": "Highlight the value field while scrubbing.",
              "enabled": true,
              "when": {
                "dragging": true
              },
              "patches": {
                "component": {},
                "parts": {
                  "valueField": {
                    "Background.Fill.colour": "FF203141",
                    "Background.Border.colour": "FF5B9BD5"
                  }
                }
              }
            },
            "Focused": {
              "_type": "State",
              "name": "Focused",
              "group": "interaction",
              "description": "Accent the editable value field while focused.",
              "enabled": true,
              "when": {
                "focused": true
              },
              "patches": {
                "component": {},
                "parts": {
                  "valueField": {
                    "Background.Border.colour": "FF89C2FF"
                  }
                }
              }
            },
            "Disabled": {
              "_type": "State",
              "name": "Disabled",
              "group": "system",
              "description": "Dim the range control when disabled.",
              "enabled": true,
              "when": {
                "disabled": true
              },
              "patches": {
                "component": {
                  "Transform.opacity": 0.55
                },
                "parts": {}
              }
            }
          }
        },
        "Animations": {
          "_type": "Animations",
          "enabled": true,
          "debug": false,
          "_children": {
            "pressIn": {
              "_type": "Animation",
              "name": "pressIn",
              "enabled": true,
              "kind": "transition",
              "trigger": {
                "type": "stateChange",
                "from": [
