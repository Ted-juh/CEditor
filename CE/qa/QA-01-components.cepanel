            "Hover": {
              "_type": "State",
              "name": "Hover",
              "group": "interaction",
              "description": "Slightly lift the active pointer while hovering.",
              "enabled": true,
              "when": {
                "hover": true
              },
              "patches": {
                "component": {},
                "parts": {
                  "pointerCurrent": {
                    "Layout.scale": 1.06
                  }
                }
              }
            },
            "Pressed": {
              "_type": "State",
              "name": "Pressed",
              "group": "interaction",
