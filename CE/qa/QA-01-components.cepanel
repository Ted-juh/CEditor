                    "transform"
                  ]
                }
              ],
              "duration": 90,
              "delay": 0,
              "easing": "outQuad"
            }
          }
        },
        "Scripts": {
          "_type": "Scripts",
          "enabled": true,
          "runInPreview": true,
          "scripts": []
        }
