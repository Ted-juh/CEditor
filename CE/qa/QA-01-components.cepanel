          "enabled": true,
          "debug": false,
          "bindings": []
        },
        "States": {
          "_type": "States",
          "enabled": true,
          "debug": false,
          "priority": [
            "hover",
            "focused",
            "dragging",
            "pressed",
            "disabled"
          ],
          "_children": {
            "Hover": {
              "_type": "State",
              "name": "Hover",
              "group": "interaction",
              "description": "Lift the step buttons and value fields while hovering.",
              "enabled": true,
              "when": {
                "hover": true
              },
              "patches": {
                "component": {},
                "parts": {
                  "decrement": {
                    "Background.Fill.colour": "FF3D3D3D"
                  },
                  "increment": {
                    "Background.Fill.colour": "FF3D3D3D"
                  },
                  "lowField": {
                    "Background.Fill.colour": "FF1B1B1B"
                  },
                  "highField": {
                    "Background.Fill.colour": "FF1B1B1B"
                  }
                }
              }
            },
            "Pressed": {
              "_type": "State",
              "name": "Pressed",
              "group": "interaction",
              "description": "Tighten the control while pressing.",
              "enabled": true,
              "when": {
                "pressed": true
              },
              "patches": {
                "component": {
                  "Transform.scale": 0.99
                },
                "parts": {
                  "decrement": {
                    "Background.Fill.colour": "FF282828"
                  },
                  "increment": {
                    "Background.Fill.colour": "FF282828"
                  }
                }
              }
            },
            "ActiveLow": {
              "_type": "State",
              "name": "ActiveLow",
              "group": "interaction",
              "description": "Accent the low field while it is the active (edited) value.",
              "enabled": true,
              "when": {
                "activeHandle": "start"
              },
              "patches": {
                "component": {},
                "parts": {
                  "lowField": {
                    "Background.Border.colour": "FF89C2FF"
                  },
                  "highField": {
                    "Background.Border.colour": "665B5B5B"
                  }
                }
              }
            },
            "ActiveHigh": {
              "_type": "State",
              "name": "ActiveHigh",
              "group": "interaction",
              "description": "Accent the high field while it is the active (edited) value.",
              "enabled": true,
              "when": {
                "activeHandle": "end"
              },
              "patches": {
                "component": {},
                "parts": {
                  "highField": {
                    "Background.Border.colour": "FF89C2FF"
                  },
                  "lowField": {
                    "Background.Border.colour": "665B5B5B"
                  }
                }
              }
            },
            "Disabled": {
              "_type": "State",
              "name": "Disabled",
              "group": "system",
              "description": "Dim the range control when disabled.",
              "enabled": true,
              "when": {
                "disabled": true
              },
              "patches": {
                "component": {
                  "Transform.opacity": 0.55
                },
                "parts": {}
              }
            }
          }
        },
