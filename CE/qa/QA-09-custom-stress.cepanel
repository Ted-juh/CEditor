  "scripts": [
    {
      "id": "stress_xy_waveform_js",
      "name": "XY chooses waveform (JavaScript)",
      "language": "javascript",
      "source": "function onValueChanged(value) {\n  const n = Number(value);\n  set(\"Waveform Selector.waveform\", n >= 0.5 ? \"square\" : \"sine\");\n  log(\"stress-js:\" + n.toFixed(3));\n}\n",
      "scope": "component",
      "target": "XY Pad",
      "event": "onValueChanged",
      "enabled": true,
      "description": "",
      "group": ""
    },
    {
      "id": "stress_meter_ladder_lua",
      "name": "Meter mirrors ladder (Lua)",
      "language": "lua",
      "source": "function onValueChanged(value)\n  local n = tonumber(value) or 0\n  set(\"Vertical LED Ladder.amount\", n)\n  log(\"stress-lua:\" .. tostring(n))\nend\n",
      "scope": "component",
      "target": "Segment Meter",
      "event": "onValueChanged",
      "enabled": true,
      "description": "",
      "group": ""
    }
  ],
