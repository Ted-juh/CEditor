              "source": "void onDoubleClick(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onDoubleClick",
              "enabled": true,
              "description": "Double-clicked.",
              "group": ""
            },
            "qa04_cpp_pointerDown": {
              "id": "qa04_cpp_pointerDown",
              "name": "cpp: onPointerDown",
              "language": "cpp",
              "source": "void onPointerDown(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onPointerDown",
              "enabled": true,
              "description": "Mouse pressed. mouse.x/.y/.button/.modifiers.",
              "group": ""
            },
            "qa04_cpp_pointerMove": {
              "id": "qa04_cpp_pointerMove",
