              "radius": 4
            }
          }
        },
        "Text": {
          "content": "typescript\n37 handlers"
        },
        "Scripts": {
          "_type": "Scripts",
          "_children": {
            "qa04_typescript_valueChange": {
              "id": "qa04_typescript_valueChange",
              "name": "typescript: onValueChange",
              "language": "typescript",
              "source": "function onValueChange(value) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onValueChange",
              "enabled": true,
              "description": "Fires over and over while the value is moving. Use it for things on screen that should follow the control.",
              "group": ""
            },
            "qa04_typescript_valueChanged": {
              "id": "qa04_typescript_valueChanged",
              "name": "typescript: onValueChanged",
              "language": "typescript",
              "source": "function onValueChanged(value) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onValueChanged",
              "enabled": true,
              "description": "Fires once, when the value settles. This is the moment to tell the synth.",
              "group": ""
            },
            "qa04_typescript_click": {
              "id": "qa04_typescript_click",
              "name": "typescript: onClick",
              "language": "typescript",
              "source": "function onClick(mouse) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onClick",
              "enabled": true,
              "description": "Clicked. mouse.x, mouse.y.",
              "group": ""
            },
            "qa04_typescript_doubleClick": {
              "id": "qa04_typescript_doubleClick",
              "name": "typescript: onDoubleClick",
              "language": "typescript",
              "source": "function onDoubleClick(mouse) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onDoubleClick",
              "enabled": true,
              "description": "Double-clicked.",
              "group": ""
            },
            "qa04_typescript_pointerDown": {
              "id": "qa04_typescript_pointerDown",
              "name": "typescript: onPointerDown",
              "language": "typescript",
              "source": "function onPointerDown(mouse) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onPointerDown",
              "enabled": true,
              "description": "Mouse pressed. mouse.x/.y/.button/.modifiers.",
              "group": ""
            },
            "qa04_typescript_pointerMove": {
              "id": "qa04_typescript_pointerMove",
              "name": "typescript: onPointerMove",
              "language": "typescript",
              "source": "function onPointerMove(mouse) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onPointerMove",
              "enabled": true,
              "description": "Mouse moved while down.",
              "group": ""
            },
            "qa04_typescript_pointerUp": {
              "id": "qa04_typescript_pointerUp",
              "name": "typescript: onPointerUp",
              "language": "typescript",
              "source": "function onPointerUp(mouse) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onPointerUp",
              "enabled": true,
              "description": "Mouse released.",
              "group": ""
            },
            "qa04_typescript_hoverStart": {
              "id": "qa04_typescript_hoverStart",
              "name": "typescript: onHoverStart",
              "language": "typescript",
              "source": "function onHoverStart() {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onHoverStart",
              "enabled": true,
              "description": "Mouse entered the control.",
              "group": ""
            },
            "qa04_typescript_hoverEnd": {
              "id": "qa04_typescript_hoverEnd",
              "name": "typescript: onHoverEnd",
              "language": "typescript",
              "source": "function onHoverEnd() {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onHoverEnd",
              "enabled": true,
              "description": "Mouse left the control.",
              "group": ""
            },
            "qa04_typescript_wheel": {
              "id": "qa04_typescript_wheel",
              "name": "typescript: onWheel",
              "language": "typescript",
              "source": "function onWheel(wheel) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onWheel",
              "enabled": true,
              "description": "Scrolled over the control. wheel.delta.",
              "group": ""
            },
            "qa04_typescript_stateChanged": {
              "id": "qa04_typescript_stateChanged",
              "name": "typescript: onStateChanged",
              "language": "typescript",
              "source": "function onStateChanged(state) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onStateChanged",
              "enabled": true,
              "description": "The control changed state: hover, pressed or disabled.",
              "group": ""
            },
            "qa04_typescript_controlChanged": {
              "id": "qa04_typescript_controlChanged",
              "name": "typescript: onControlChanged",
              "language": "typescript",
              "source": "function onControlChanged(info) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onControlChanged",
              "enabled": true,
              "description": "Any control changed. info.target, info.value.",
              "group": ""
            },
            "qa04_typescript_timer": {
              "id": "qa04_typescript_timer",
              "name": "typescript: onTimer",
              "language": "typescript",
              "source": "function onTimer(info) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onTimer",
              "enabled": true,
              "description": "A started timer fired. info.id.",
              "group": ""
            },
            "qa04_typescript_beat": {
              "id": "qa04_typescript_beat",
              "name": "typescript: onBeat",
              "language": "typescript",
              "source": "function onBeat(time) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onBeat",
              "enabled": true,
              "description": "A beat passed. time.bar, time.beat, time.beats, time.bpm. Message-thread accurate (~30Hz), not sample-accurate.",
              "group": ""
            },
            "qa04_typescript_bar": {
              "id": "qa04_typescript_bar",
              "name": "typescript: onBar",
              "language": "typescript",
              "source": "function onBar(time) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onBar",
              "enabled": true,
              "description": "A bar passed. time.bar, time.beats, time.beatsPerBar. Fires with the downbeat, alongside onBeat.",
              "group": ""
            },
            "qa04_typescript_transport": {
              "id": "qa04_typescript_transport",
              "name": "typescript: onTransport",
              "language": "typescript",
              "source": "function onTransport(time) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onTransport",
              "enabled": true,
              "description": "The transport started, stopped, or changed tempo. time.playing, time.bpm, time.source.",
              "group": ""
            },
            "qa04_typescript_parameterReceived": {
              "id": "qa04_typescript_parameterReceived",
              "name": "typescript: onParameterReceived",
              "language": "typescript",
              "source": "function onParameterReceived(info) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onParameterReceived",
              "enabled": true,
              "description": "A value arrived, decoded via the DPD. info.parameter, info.value.",
              "group": ""
            },
            "qa04_typescript_dumpReceived": {
              "id": "qa04_typescript_dumpReceived",
              "name": "typescript: onDumpReceived",
              "language": "typescript",
              "source": "function onDumpReceived(dump) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onDumpReceived",
              "enabled": true,
              "description": "A bulk dump arrived. dump.bytes, dump.kind. Use applyDump(dump.bytes) to fill the panel.",
              "group": ""
            },
            "qa04_typescript_presetChange": {
              "id": "qa04_typescript_presetChange",
              "name": "typescript: onPresetChange",
              "language": "typescript",
              "source": "function onPresetChange(preset) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onPresetChange",
              "enabled": true,
              "description": "The current preset changed. preset.slot, preset.program, preset.name, preset.category, preset.bankId, preset.source (\"device\" when the instrument sent a Program Change, \"panel\" when recallPreset did it).",
              "group": ""
            },
            "qa04_typescript_midiIn": {
              "id": "qa04_typescript_midiIn",
              "name": "typescript: onMidiIn",
              "language": "typescript",
              "source": "function onMidiIn(midi) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onMidiIn",
              "enabled": true,
              "description": "Any MIDI arrived (raw). midi.bytes, midi.channel, midi.status.",
              "group": ""
            },
            "qa04_typescript_ccIn": {
              "id": "qa04_typescript_ccIn",
              "name": "typescript: onCcIn",
              "language": "typescript",
              "source": "function onCcIn(cc) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onCcIn",
              "enabled": true,
              "description": "A CC arrived. cc.channel, cc.cc, cc.value. cc.channel is 0-based here, unlike sendCC and onNoteIn.",
              "group": ""
            },
            "qa04_typescript_noteIn": {
              "id": "qa04_typescript_noteIn",
              "name": "typescript: onNoteIn",
              "language": "typescript",
              "source": "function onNoteIn(note) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onNoteIn",
              "enabled": true,
              "description": "A note was played. note.channel (1-16, matching sendNote), note.note, note.velocity. A note-on with velocity 0 counts as a note-off and arrives as onNoteOffIn instead.",
              "group": ""
            },
            "qa04_typescript_noteOffIn": {
              "id": "qa04_typescript_noteOffIn",
              "name": "typescript: onNoteOffIn",
              "language": "typescript",
              "source": "function onNoteOffIn(note) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onNoteOffIn",
              "enabled": true,
              "description": "A note was released. note.channel (1-16), note.note, note.velocity (the release velocity, 0 when the device sent a note-on with velocity 0 instead of a note-off).",
              "group": ""
            },
            "qa04_typescript_sysexIn": {
              "id": "qa04_typescript_sysexIn",
              "name": "typescript: onSysexIn",
              "language": "typescript",
              "source": "function onSysexIn(bytes) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onSysexIn",
              "enabled": true,
              "description": "Raw SysEx arrived.",
              "group": ""
            },
            "qa04_typescript_deviceConnected": {
              "id": "qa04_typescript_deviceConnected",
              "name": "typescript: onDeviceConnected",
              "language": "typescript",
              "source": "function onDeviceConnected(device) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onDeviceConnected",
              "enabled": true,
              "description": "A device connected.",
              "group": ""
            },
            "qa04_typescript_deviceDisconnected": {
              "id": "qa04_typescript_deviceDisconnected",
              "name": "typescript: onDeviceDisconnected",
              "language": "typescript",
              "source": "function onDeviceDisconnected(device) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onDeviceDisconnected",
              "enabled": true,
              "description": "A device disconnected.",
              "group": ""
            },
            "qa04_typescript_step": {
              "id": "qa04_typescript_step",
              "name": "typescript: onStep",
              "language": "typescript",
              "source": "function onStep(step) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onStep",
              "enabled": true,
              "description": "A sequencer advanced. step.target, step.index (1-based), step.of, step.notes. Raised by the Arpeggiator, Turing Machine, Phrase Sequencer and Looper.",
              "group": ""
            },
            "qa04_typescript_cycle": {
              "id": "qa04_typescript_cycle",
              "name": "typescript: onCycle",
              "language": "typescript",
              "source": "function onCycle(cycle) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onCycle",
              "enabled": true,
              "description": "A sequence or loop came back round. cycle.target, cycle.count (how many times since the panel opened). Arpeggiator, Turing, Looper, Orbit.",
              "group": ""
            },
            "qa04_typescript_hit": {
              "id": "qa04_typescript_hit",
              "name": "typescript: onHit",
              "language": "typescript",
              "source": "function onHit(hit) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onHit",
              "enabled": true,
              "description": "A pad, key or ribbon was struck. hit.target, hit.id, hit.note, hit.velocity. Chord Pad, Drum Pads, Note Ribbon.",
              "group": ""
            },
            "qa04_typescript_release": {
              "id": "qa04_typescript_release",
              "name": "typescript: onRelease",
              "language": "typescript",
              "source": "function onRelease(release) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onRelease",
              "enabled": true,
              "description": "A pad, key or ribbon was released. release.target, release.id, release.note.",
              "group": ""
            },
            "qa04_typescript_scene": {
              "id": "qa04_typescript_scene",
              "name": "typescript: onScene",
              "language": "typescript",
              "source": "function onScene(scene) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onScene",
              "enabled": true,
              "description": "The Setlist recalled a scene. scene.target, scene.index (1-based), scene.name. Fires on any recall, scripted or footswitch.",
              "group": ""
            },
            "qa04_typescript_stage": {
              "id": "qa04_typescript_stage",
              "name": "typescript: onStage",
              "language": "typescript",
              "source": "function onStage(stage) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onStage",
              "enabled": true,
              "description": "A component entered a new stage. stage.target, stage.stage, stage.previous. Raised by the Recorder (\"idle\"/\"armed\"/\"recording\"/\"overdub\") and the Envelope (\"sustain\"/\"release\"/\"end\"). Not onStateChanged, which is a control's hover/pressed state.",
              "group": ""
            },
            "qa04_typescript_settled": {
              "id": "qa04_typescript_settled",
              "name": "typescript: onSettled",
              "language": "typescript",
              "source": "function onSettled(settled) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onSettled",
              "enabled": true,
              "description": "A spring-return control finished gliding home. settled.target, settled.value. Ribbon, Crossfader, Vector Joystick.",
              "group": ""
            },
            "qa04_typescript_bounce": {
              "id": "qa04_typescript_bounce",
              "name": "typescript: onBounce",
              "language": "typescript",
              "source": "function onBounce(bounce) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onBounce",
              "enabled": true,
              "description": "The Kinetic ball hit a wall. bounce.target, bounce.x, bounce.y, bounce.vx, bounce.vy.",
              "group": ""
            },
            "qa04_typescript_recall": {
              "id": "qa04_typescript_recall",
              "name": "typescript: onRecall",
              "language": "typescript",
              "source": "function onRecall(recall) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onRecall",
              "enabled": true,
              "description": "The Constellation snapped to a preset. recall.target, recall.id, recall.label. Snap mode only — blend mode does not fire it.",
              "group": ""
            },
            "qa04_typescript_zone": {
              "id": "qa04_typescript_zone",
              "name": "typescript: onZone",
              "language": "typescript",
              "source": "function onZone(zone) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onZone",
              "enabled": true,
              "description": "A Meter crossed into a different threshold zone. zone.target, zone.zone, zone.previous, zone.value.",
              "group": ""
            },
            "qa04_typescript_voiced": {
              "id": "qa04_typescript_voiced",
              "name": "typescript: onVoiced",
              "language": "typescript",
              "source": "function onVoiced(voiced) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onVoiced",
              "enabled": true,
              "description": "A component turned a played note into other notes. voiced.target, voiced.note, voiced.velocity, voiced.out (the notes it produced). Raised by the Zone Splitter and the Harmoniser.",
              "group": ""
            }
          }
        }
      },
      "_type": "Control"
    },
