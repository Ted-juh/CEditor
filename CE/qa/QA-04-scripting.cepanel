            },
            "qa04_cpp_timer": {
              "id": "qa04_cpp_timer",
              "name": "cpp: onTimer",
              "language": "cpp",
              "source": "void onTimer(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
