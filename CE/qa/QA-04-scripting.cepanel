            "qa04_csharp_hoverStart": {
              "id": "qa04_csharp_hoverStart",
              "name": "csharp: onHoverStart",
              "language": "csharp",
              "source": "void onHoverStart(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onHoverStart",
              "enabled": true,
              "description": "Mouse entered the control.",
              "group": ""
            },
            "qa04_csharp_hoverEnd": {
              "id": "qa04_csharp_hoverEnd",
              "name": "csharp: onHoverEnd",
              "language": "csharp",
              "source": "void onHoverEnd(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onHoverEnd",
              "enabled": true,
              "description": "Mouse left the control.",
              "group": ""
            },
            "qa04_csharp_wheel": {
              "id": "qa04_csharp_wheel",
              "name": "csharp: onWheel",
              "language": "csharp",
              "source": "void onWheel(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onWheel",
              "enabled": true,
              "description": "Scrolled over the control. wheel.delta.",
              "group": ""
            },
            "qa04_csharp_stateChanged": {
              "id": "qa04_csharp_stateChanged",
              "name": "csharp: onStateChanged",
              "language": "csharp",
              "source": "void onStateChanged(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onStateChanged",
              "enabled": true,
              "description": "The control changed state: hover, pressed or disabled.",
              "group": ""
            },
            "qa04_csharp_controlChanged": {
              "id": "qa04_csharp_controlChanged",
              "name": "csharp: onControlChanged",
              "language": "csharp",
              "source": "void onControlChanged(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onControlChanged",
              "enabled": true,
              "description": "Any control changed. info.target, info.value.",
              "group": ""
            },
            "qa04_csharp_timer": {
              "id": "qa04_csharp_timer",
              "name": "csharp: onTimer",
              "language": "csharp",
              "source": "void onTimer(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onTimer",
              "enabled": true,
              "description": "A started timer fired. info.id.",
              "group": ""
            },
            "qa04_csharp_beat": {
              "id": "qa04_csharp_beat",
              "name": "csharp: onBeat",
              "language": "csharp",
              "source": "void onBeat(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onBeat",
              "enabled": true,
              "description": "A beat passed. time.bar, time.beat, time.beats, time.bpm. Message-thread accurate (~30Hz), not sample-accurate.",
              "group": ""
            },
            "qa04_csharp_bar": {
              "id": "qa04_csharp_bar",
              "name": "csharp: onBar",
              "language": "csharp",
              "source": "void onBar(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onBar",
              "enabled": true,
              "description": "A bar passed. time.bar, time.beats, time.beatsPerBar. Fires with the downbeat, alongside onBeat.",
              "group": ""
            },
            "qa04_csharp_transport": {
              "id": "qa04_csharp_transport",
              "name": "csharp: onTransport",
              "language": "csharp",
              "source": "void onTransport(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onTransport",
              "enabled": true,
              "description": "The transport started, stopped, or changed tempo. time.playing, time.bpm, time.source.",
              "group": ""
            },
            "qa04_csharp_parameterReceived": {
              "id": "qa04_csharp_parameterReceived",
              "name": "csharp: onParameterReceived",
              "language": "csharp",
              "source": "void onParameterReceived(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onParameterReceived",
              "enabled": true,
              "description": "A value arrived, decoded via the DPD. info.parameter, info.value.",
              "group": ""
            },
            "qa04_csharp_dumpReceived": {
              "id": "qa04_csharp_dumpReceived",
              "name": "csharp: onDumpReceived",
              "language": "csharp",
              "source": "void onDumpReceived(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onDumpReceived",
              "enabled": true,
              "description": "A bulk dump arrived. dump.bytes, dump.kind. Use applyDump(dump.bytes) to fill the panel.",
              "group": ""
            },
            "qa04_csharp_presetChange": {
              "id": "qa04_csharp_presetChange",
              "name": "csharp: onPresetChange",
              "language": "csharp",
              "source": "void onPresetChange(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onPresetChange",
              "enabled": true,
              "description": "The current preset changed. preset.slot, preset.program, preset.name, preset.category, preset.bankId, preset.source (\"device\" when the instrument sent a Program Change, \"panel\" when recallPreset did it).",
              "group": ""
            },
            "qa04_csharp_midiIn": {
              "id": "qa04_csharp_midiIn",
              "name": "csharp: onMidiIn",
              "language": "csharp",
              "source": "void onMidiIn(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onMidiIn",
              "enabled": true,
              "description": "Any MIDI arrived (raw). midi.bytes, midi.channel, midi.status.",
              "group": ""
            },
            "qa04_csharp_ccIn": {
              "id": "qa04_csharp_ccIn",
              "name": "csharp: onCcIn",
              "language": "csharp",
              "source": "void onCcIn(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onCcIn",
              "enabled": true,
              "description": "A CC arrived. cc.channel, cc.cc, cc.value. cc.channel is 0-based here, unlike sendCC and onNoteIn.",
              "group": ""
            },
            "qa04_csharp_noteIn": {
              "id": "qa04_csharp_noteIn",
              "name": "csharp: onNoteIn",
              "language": "csharp",
              "source": "void onNoteIn(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onNoteIn",
              "enabled": true,
              "description": "A note was played. note.channel (1-16, matching sendNote), note.note, note.velocity. A note-on with velocity 0 counts as a note-off and arrives as onNoteOffIn instead.",
              "group": ""
            },
            "qa04_csharp_noteOffIn": {
              "id": "qa04_csharp_noteOffIn",
              "name": "csharp: onNoteOffIn",
              "language": "csharp",
              "source": "void onNoteOffIn(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onNoteOffIn",
              "enabled": true,
              "description": "A note was released. note.channel (1-16), note.note, note.velocity (the release velocity, 0 when the device sent a note-on with velocity 0 instead of a note-off).",
              "group": ""
            },
            "qa04_csharp_sysexIn": {
              "id": "qa04_csharp_sysexIn",
              "name": "csharp: onSysexIn",
              "language": "csharp",
              "source": "void onSysexIn(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onSysexIn",
              "enabled": true,
              "description": "Raw SysEx arrived.",
              "group": ""
            },
            "qa04_csharp_deviceConnected": {
              "id": "qa04_csharp_deviceConnected",
              "name": "csharp: onDeviceConnected",
              "language": "csharp",
              "source": "void onDeviceConnected(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onDeviceConnected",
              "enabled": true,
              "description": "A device connected.",
              "group": ""
            },
            "qa04_csharp_deviceDisconnected": {
              "id": "qa04_csharp_deviceDisconnected",
              "name": "csharp: onDeviceDisconnected",
              "language": "csharp",
              "source": "void onDeviceDisconnected(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onDeviceDisconnected",
              "enabled": true,
              "description": "A device disconnected.",
              "group": ""
            },
            "qa04_csharp_step": {
              "id": "qa04_csharp_step",
              "name": "csharp: onStep",
              "language": "csharp",
              "source": "void onStep(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onStep",
              "enabled": true,
              "description": "A sequencer advanced. step.target, step.index (1-based), step.of, step.notes. Raised by the Arpeggiator, Turing Machine, Phrase Sequencer and Looper.",
              "group": ""
            },
            "qa04_csharp_cycle": {
              "id": "qa04_csharp_cycle",
              "name": "csharp: onCycle",
              "language": "csharp",
              "source": "void onCycle(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onCycle",
              "enabled": true,
              "description": "A sequence or loop came back round. cycle.target, cycle.count (how many times since the panel opened). Arpeggiator, Turing, Looper, Orbit.",
              "group": ""
            },
            "qa04_csharp_hit": {
              "id": "qa04_csharp_hit",
              "name": "csharp: onHit",
              "language": "csharp",
              "source": "void onHit(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onHit",
              "enabled": true,
              "description": "A pad, key or ribbon was struck. hit.target, hit.id, hit.note, hit.velocity. Chord Pad, Drum Pads, Note Ribbon.",
              "group": ""
            },
            "qa04_csharp_release": {
              "id": "qa04_csharp_release",
              "name": "csharp: onRelease",
              "language": "csharp",
              "source": "void onRelease(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onRelease",
              "enabled": true,
              "description": "A pad, key or ribbon was released. release.target, release.id, release.note.",
              "group": ""
            },
            "qa04_csharp_scene": {
              "id": "qa04_csharp_scene",
              "name": "csharp: onScene",
              "language": "csharp",
              "source": "void onScene(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onScene",
              "enabled": true,
              "description": "The Setlist recalled a scene. scene.target, scene.index (1-based), scene.name. Fires on any recall, scripted or footswitch.",
              "group": ""
            },
            "qa04_csharp_stage": {
              "id": "qa04_csharp_stage",
              "name": "csharp: onStage",
              "language": "csharp",
              "source": "void onStage(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onStage",
              "enabled": true,
              "description": "A component entered a new stage. stage.target, stage.stage, stage.previous. Raised by the Recorder (\"idle\"/\"armed\"/\"recording\"/\"overdub\") and the Envelope (\"sustain\"/\"release\"/\"end\"). Not onStateChanged, which is a control's hover/pressed state.",
              "group": ""
            },
            "qa04_csharp_settled": {
              "id": "qa04_csharp_settled",
              "name": "csharp: onSettled",
              "language": "csharp",
              "source": "void onSettled(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onSettled",
              "enabled": true,
              "description": "A spring-return control finished gliding home. settled.target, settled.value. Ribbon, Crossfader, Vector Joystick.",
              "group": ""
            },
            "qa04_csharp_bounce": {
              "id": "qa04_csharp_bounce",
              "name": "csharp: onBounce",
              "language": "csharp",
              "source": "void onBounce(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onBounce",
              "enabled": true,
              "description": "The Kinetic ball hit a wall. bounce.target, bounce.x, bounce.y, bounce.vx, bounce.vy.",
              "group": ""
            },
            "qa04_csharp_recall": {
              "id": "qa04_csharp_recall",
              "name": "csharp: onRecall",
              "language": "csharp",
              "source": "void onRecall(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onRecall",
              "enabled": true,
              "description": "The Constellation snapped to a preset. recall.target, recall.id, recall.label. Snap mode only — blend mode does not fire it.",
              "group": ""
            },
            "qa04_csharp_zone": {
              "id": "qa04_csharp_zone",
              "name": "csharp: onZone",
              "language": "csharp",
              "source": "void onZone(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onZone",
              "enabled": true,
              "description": "A Meter crossed into a different threshold zone. zone.target, zone.zone, zone.previous, zone.value.",
              "group": ""
            },
            "qa04_csharp_voiced": {
              "id": "qa04_csharp_voiced",
              "name": "csharp: onVoiced",
              "language": "csharp",
              "source": "void onVoiced(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onVoiced",
              "enabled": true,
              "description": "A component turned a played note into other notes. voiced.target, voiced.note, voiced.velocity, voiced.out (the notes it produced). Raised by the Zone Splitter and the Harmoniser.",
              "group": ""
            }
          }
        }
      },
      "_type": "Control"
    },
