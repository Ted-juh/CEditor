        "Text": {"content":"java\n55 handlers"},
        "Scripts": {"_type":"Scripts","_children":{"qa04_java_valueChange":{"id":"qa04_java_valueChange","name":"java: onValueChange","language":"java","source":"void onValueChange(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onValueChange","enabled":true,"description":"Runs again and again while the value moves, as a knob is dragged: for what on screen follows the control.","group":""},"qa04_java_valueChanged":{"id":"qa04_java_valueChanged","name":"java: onValueChanged","language":"java","source":"void onValueChanged(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onValueChanged","enabled":true,"description":"Runs once, when the value settles, as a knob is let go: the moment to tell the synth.","group":""},"qa04_java_activeHandleChanged":{"id":"qa04_java_activeHandleChanged","name":"java: onActiveHandleChanged","language":"java","source":"void onActiveHandleChanged(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onActiveHandleChanged","enabled":true,"description":"A slider with more than one handle moved to another handle. `info.activeHandle` and `info.previousActiveHandle` are each \"start\", \"current\" or \"end\".","group":""},"qa04_java_click":{"id":"qa04_java_click","name":"java: onClick","language":"java","source":"void onClick(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onClick","enabled":true,"description":"The control was clicked. `mouse.x` and `mouse.y` say where, inside the control.","group":""},"qa04_java_doubleClick":{"id":"qa04_java_doubleClick","name":"java: onDoubleClick","language":"java","source":"void onDoubleClick(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onDoubleClick","enabled":true,"description":"The control was double-clicked. `mouse.x` and `mouse.y` say where.","group":""},"qa04_java_pointerDown":{"id":"qa04_java_pointerDown","name":"java: onPointerDown","language":"java","source":"void onPointerDown(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onPointerDown","enabled":true,"description":"A mouse button was pressed on the control. `mouse.x` and `mouse.y` say where, `mouse.button` which button, and `mouse.modifiers` the keys held.","group":""},"qa04_java_pointerMove":{"id":"qa04_java_pointerMove","name":"java: onPointerMove","language":"java","source":"void onPointerMove(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onPointerMove","enabled":true,"description":"The mouse moved while a button was held down on the control. `mouse.x` and `mouse.y` give the new position.","group":""},"qa04_java_pointerUp":{"id":"qa04_java_pointerUp","name":"java: onPointerUp","language":"java","source":"void onPointerUp(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onPointerUp","enabled":true,"description":"The mouse button was released.","group":""},"qa04_java_hoverStart":{"id":"qa04_java_hoverStart","name":"java: onHoverStart","language":"java","source":"void onHoverStart(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onHoverStart","enabled":true,"description":"The mouse pointer moved onto the control.","group":""},"qa04_java_hoverEnd":{"id":"qa04_java_hoverEnd","name":"java: onHoverEnd","language":"java","source":"void onHoverEnd(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onHoverEnd","enabled":true,"description":"The mouse pointer left the control.","group":""},"qa04_java_wheel":{"id":"qa04_java_wheel","name":"java: onWheel","language":"java","source":"void onWheel(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onWheel","enabled":true,"description":"The mouse wheel was turned over the control. `wheel.delta` says how far, and in which direction.","group":""},"qa04_java_stateChanged":{"id":"qa04_java_stateChanged","name":"java: onStateChanged","language":"java","source":"void onStateChanged(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onStateChanged","enabled":true,"description":"The control's look changed. `state` is \"normal\", \"hover\", \"pressed\" or \"disabled\".","group":""},"qa04_java_controlChanged":{"id":"qa04_java_controlChanged","name":"java: onControlChanged","language":"java","source":"void onControlChanged(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onControlChanged","enabled":true,"description":"A control on the panel changed. `info.target` is its name and `info.value` its new value: one handler for many controls.","group":""},"qa04_java_timer":{"id":"qa04_java_timer","name":"java: onTimer","language":"java","source":"void onTimer(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onTimer","enabled":true,"description":"A timer you started is due. `info.id` is the name you gave it in `ce.time.startTimer()` or `ce.time.syncTimer()`.","group":""},"qa04_java_keyDown":{"id":"qa04_java_keyDown","name":"java: onKeyDown","language":"java","source":"void onKeyDown(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onKeyDown","enabled":true,"description":"A key went down that nothing else on the panel kept: not while typing, and not the panic key, a shortcut, a piano key or a key the focused control used. `key.key` is its name as printed (\"R\", \"7\", \"Space\", \"Up\", \"F2\"), `key.code` its place, the same on every layout (\"KeyR\"), `key.ctrl`, `key.shift`, `key.alt` and `key.meta` the modifiers, `key.repeat` true while the system repeats a held key, and `key.control` the control that has the keyboard. Return true to keep the key: it then goes no further, not to the DAW and not to the editor.","group":""},"qa04_java_keyUp":{"id":"qa04_java_keyUp","name":"java: onKeyUp","language":"java","source":"void onKeyUp(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onKeyUp","enabled":true,"description":"A key whose keyDown was raised went up, with the same fields except `repeat`. Also raised for every such key when the panel loses the keyboard while it is held. Its return value is not used.","group":""},"qa04_java_beat":{"id":"qa04_java_beat","name":"java: onBeat","language":"java","source":"void onBeat(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onBeat","enabled":true,"description":"A beat went by while the transport plays. `time.bar` and `time.beat` give where, `time.beats` the beats so far, and `time.bpm` the tempo. Within a thirtieth of a second: right for a light or a display, not for timing sound.","group":""},"qa04_java_bar":{"id":"qa04_java_bar","name":"java: onBar","language":"java","source":"void onBar(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onBar","enabled":true,"description":"A bar began, on the downbeat, with onBeat. `time.bar` is its number, `time.beats` the beats so far, and `time.beatsPerBar` the beats in a bar.","group":""},"qa04_java_transport":{"id":"qa04_java_transport","name":"java: onTransport","language":"java","source":"void onTransport(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onTransport","enabled":true,"description":"The transport started, stopped or changed tempo. `time.playing` says whether it runs, `time.bpm` gives the tempo and `time.source` what drives it.","group":""},"qa04_java_parameterReceived":{"id":"qa04_java_parameterReceived","name":"java: onParameterReceived","language":"java","source":"void onParameterReceived(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onParameterReceived","enabled":true,"description":"The synth sent a parameter's value, read through its profile. `info.parameter` is the parameter's id and `info.value` its value, in the parameter's own units.","group":""},"qa04_java_dumpReceived":{"id":"qa04_java_dumpReceived","name":"java: onDumpReceived","language":"java","source":"void onDumpReceived(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onDumpReceived","enabled":true,"description":"A dump from the synth arrived and was read; the controls bound to it are filled in already. `dump.values` holds each value by parameter id, `dump.kind` names the dump, such as \"patch\", and `dump.role` the synth it came from.","group":""},"qa04_java_oscIn":{"id":"qa04_java_oscIn","name":"java: onOscIn","language":"java","source":"void onOscIn(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onOscIn","enabled":true,"description":"An OSC message arrived on the port ce.osc.listen() opened. `message.address` is where it was sent, `message.args` its values, `message.types` their OSC types, `message.from` who sent it ({ host, port }), and `message.time` a bundle's time. origin() gives \"osc\".","group":""},"qa04_java_automationIn":{"id":"qa04_java_automationIn","name":"java: onAutomationIn","language":"java","source":"void onAutomationIn(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onAutomationIn","enabled":true,"description":"The DAW moved a parameter. `move.control` is the control's name, `move.path` its path, `move.value` the new value in the control's own range and `move.id` the DAW parameter's id. The control's own value events fire too, with origin() giving \"host\". Never for a change a script or a hand made.","group":""},"qa04_java_dawProgramIn":{"id":"qa04_java_dawProgramIn","name":"java: onDawProgramIn","language":"java","source":"void onDawProgramIn(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onDawProgramIn","enabled":true,"description":"The DAW chose a program from the plug-in's bank, and the plug-in has sent it to the synth. `program.index` counts from 0, `program.number` from 1, and `program.name` is its name.","group":""},"qa04_java_ciDiscovered":{"id":"qa04_java_ciDiscovered","name":"java: onCiDiscovered","language":"java","source":"void onCiDiscovered(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onCiDiscovered","enabled":true,"description":"A MIDI-CI device answered: to ce.ci.discover(), or by announcing itself. `device` is as ce.ci.discover() describes it: `device.muid`, `device.model`, `device.names` and `device.matchesProfile` among them.","group":""},"qa04_java_ciDeviceRemoved":{"id":"qa04_java_ciDeviceRemoved","name":"java: onCiDeviceRemoved","language":"java","source":"void onCiDeviceRemoved(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onCiDeviceRemoved","enabled":true,"description":"A MIDI-CI device is gone. `device.muid` is its number and `device.role` the panel's device it was found on. Its subscriptions have ended.","group":""},"qa04_java_ciProfileChanged":{"id":"qa04_java_ciProfileChanged","name":"java: onCiProfileChanged","language":"java","source":"void onCiProfileChanged(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onCiProfileChanged","enabled":true,"description":"A MIDI-CI profile was turned on or off, by a script or on the device itself. `profile.muid` is the device, `profile.id` the profile, `profile.address` \"device\" or a channel, and `profile.enabled` its new state.","group":""},"qa04_java_verifyDone":{"id":"qa04_java_verifyDone","name":"java: onVerifyDone","language":"java","source":"void onVerifyDone(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onVerifyDone","enabled":true,"description":"A ce.verify check finished. `report` is the report its function was given: `report.kind` says which check, `report.ok` whether all was well, and `report.matched`, `report.differed` and `report.unchecked` say what was found. Raised for cancelled checks too.","group":""},"qa04_java_presetChange":{"id":"qa04_java_presetChange","name":"java: onPresetChange","language":"java","source":"void onPresetChange(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onPresetChange","enabled":true,"description":"The preset changed. `preset.slot`, `preset.program`, `preset.name`, `preset.category` and `preset.bankId` describe it; `preset.source` is \"device\" when the synth sent a Program Change, \"panel\" when the panel called recallPreset.","group":""},"qa04_java_midiIn":{"id":"qa04_java_midiIn","name":"java: onMidiIn","language":"java","source":"void onMidiIn(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onMidiIn","enabled":true,"description":"A MIDI message arrived. `midi.bytes` holds it as received, `midi.status` its first byte and `midi.channel` its channel, counted from 0. `midi.from` is the device it came from.","group":""},"qa04_java_ccIn":{"id":"qa04_java_ccIn","name":"java: onCcIn","language":"java","source":"void onCcIn(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onCcIn","enabled":true,"description":"A controller message arrived. `cc.cc` is the controller number and `cc.value` its value; `cc.channel` counts from 0 here, 0 to 15, where sendCC and onNoteIn count 1 to 16. `cc.from` is the device it came from.","group":""},"qa04_java_noteIn":{"id":"qa04_java_noteIn","name":"java: onNoteIn","language":"java","source":"void onNoteIn(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onNoteIn","enabled":true,"description":"A note was played. `note.channel`, 1 to 16 as in sendNote, `note.note` and `note.velocity` describe it. A note-on at velocity 0 is a note-off in MIDI, and arrives as onNoteOffIn. `note.from` is the device it came from, and `note.id` the note's id while ce.mpe.listen() reads that device.","group":""},"qa04_java_noteOffIn":{"id":"qa04_java_noteOffIn","name":"java: onNoteOffIn","language":"java","source":"void onNoteOffIn(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onNoteOffIn","enabled":true,"description":"A note was let go. `note.channel`, 1 to 16, `note.note` and `note.velocity` describe it; the velocity is the release velocity, or 0 for a note-on at velocity 0. `note.from` and `note.id` are as onNoteIn gives them.","group":""},"qa04_java_bendIn":{"id":"qa04_java_bendIn","name":"java: onBendIn","language":"java","source":"void onBendIn(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onBendIn","enabled":true,"description":"A pitch bend arrived. `bend.value` is -8192 to 8191, 0 in the middle; `bend.amount` the same from -1 to 1; `bend.raw` 0 to 16383, as the two bytes carry it. `bend.channel` is 1 to 16 and `bend.from` the device. Raised at most once every 10 ms per channel, with the latest value.","group":""},"qa04_java_pressureIn":{"id":"qa04_java_pressureIn","name":"java: onPressureIn","language":"java","source":"void onPressureIn(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onPressureIn","enabled":true,"description":"Channel pressure arrived. `pressure.value` is 0 to 127, `pressure.amount` 0 to 1, `pressure.channel` 1 to 16 and `pressure.from` the device. Raised at most once every 10 ms per channel.","group":""},"qa04_java_polyPressureIn":{"id":"qa04_java_polyPressureIn","name":"java: onPolyPressureIn","language":"java","source":"void onPolyPressureIn(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onPolyPressureIn","enabled":true,"description":"Pressure on one note arrived. `pressure.note` is the note, `pressure.value` 0 to 127, `pressure.amount` 0 to 1, `pressure.channel` 1 to 16 and `pressure.from` the device. Raised at most once every 10 ms per note.","group":""},"qa04_java_programIn":{"id":"qa04_java_programIn","name":"java: onProgramIn","language":"java","source":"void onProgramIn(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onProgramIn","enabled":true,"description":"A program change arrived. `program.program` is 0 to 127, as the message carries it, and `program.number` 1 to 128, as most synths show it. `program.bankMsb` and `program.bankLsb` are the bank select that came just before it on this channel, when one did. `program.channel` is 1 to 16 and `program.from` the device.","group":""},"qa04_java_nrpnIn":{"id":"qa04_java_nrpnIn","name":"java: onNrpnIn","language":"java","source":"void onNrpnIn(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onNrpnIn","enabled":true,"description":"An NRPN arrived, put together from its controllers (99, 98, then 6 and 38). `nrpn.msb` and `nrpn.lsb` are the parameter number's halves, as sendNRPN takes them, and `nrpn.parameter` the two as one number. `nrpn.value` is 0 to 16383 when the fine half came (`nrpn.fine` true), else 0 to 127. For an increment or decrement, `nrpn.step` is 1 or -1 instead. The controllers still raise ccIn too.","group":""},"qa04_java_rpnIn":{"id":"qa04_java_rpnIn","name":"java: onRpnIn","language":"java","source":"void onRpnIn(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onRpnIn","enabled":true,"description":"An RPN arrived, put together from controllers 101 and 100, then 6 and 38. The fields are those of nrpnIn, and `rpn.name` is \"bendRange\", \"fineTuning\", \"coarseTuning\" or \"mpeConfiguration\" for the numbers that have one.","group":""},"qa04_java_transportIn":{"id":"qa04_java_transportIn","name":"java: onTransportIn","language":"java","source":"void onTransportIn(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onTransportIn","enabled":true,"description":"A device sent start, stop, continue or a song position. `transport.action` is \"start\", \"stop\", \"continue\" or \"position\"; for \"position\", `transport.beat` is where it points, in beats from the start. `transport.from` is the device. Clock ticks are not raised one by one.","group":""},"qa04_java_expressionIn":{"id":"qa04_java_expressionIn","name":"java: onExpressionIn","language":"java","source":"void onExpressionIn(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onExpressionIn","enabled":true,"description":"A note read with ce.mpe.listen() moved. `expression.id` is the note's id, as noteIn gave it, `expression.note` the note and `expression.channel` its member channel. `expression.bend` is in semitones, `expression.pressure` and `expression.timbre` 0 to 1, and `expression.changed` says which moved: \"bend\", \"pressure\" or \"timbre\". Raised at most once every 10 ms per note.","group":""},"qa04_java_sysexIn":{"id":"qa04_java_sysexIn","name":"java: onSysexIn","language":"java","source":"void onSysexIn(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onSysexIn","enabled":true,"description":"A SysEx message arrived. `bytes` holds it as a list of numbers.","group":""},"qa04_java_deviceConnected":{"id":"qa04_java_deviceConnected","name":"java: onDeviceConnected","language":"java","source":"void onDeviceConnected(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onDeviceConnected","enabled":true,"description":"A synth was connected and is ready. `device.role` names it and `device.profileId` its profile.","group":""},"qa04_java_deviceDisconnected":{"id":"qa04_java_deviceDisconnected","name":"java: onDeviceDisconnected","language":"java","source":"void onDeviceDisconnected(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"panel","target":"*","event":"onDeviceDisconnected","enabled":true,"description":"A synth is no longer connected and ready. `device.role` names it, and `device.message` may say why.","group":""},"qa04_java_step":{"id":"qa04_java_step","name":"java: onStep","language":"java","source":"void onStep(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onStep","enabled":true,"description":"A sequencer moved to its next step: an Arpeggiator, Turing Machine, Phrase Sequencer or Looper. `step.target` is its name, `step.index` the step, counted from 1, `step.of` how many there are, and `step.notes` the notes it plays.","group":""},"qa04_java_cycle":{"id":"qa04_java_cycle","name":"java: onCycle","language":"java","source":"void onCycle(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onCycle","enabled":true,"description":"A sequence or loop came round to its start: an Arpeggiator, Turing Machine, Looper or Orbit. `cycle.target` is its name and `cycle.count` how many times it has come round since the panel opened.","group":""},"qa04_java_hit":{"id":"qa04_java_hit","name":"java: onHit","language":"java","source":"void onHit(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onHit","enabled":true,"description":"A pad, key or strip was struck: a Chord Pad, Drum Pads or Note Ribbon. `hit.target` is its name, `hit.id` which pad or key, `hit.note` the note and `hit.velocity` how hard.","group":""},"qa04_java_release":{"id":"qa04_java_release","name":"java: onRelease","language":"java","source":"void onRelease(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onRelease","enabled":true,"description":"A pad, key or strip was let go. `release.target` is its name, `release.id` which pad or key, and `release.note` the note.","group":""},"qa04_java_scene":{"id":"qa04_java_scene","name":"java: onScene","language":"java","source":"void onScene(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onScene","enabled":true,"description":"The Setlist moved to a scene, however it was chosen. `scene.target` is its name, `scene.index` the scene, counted from 1, and `scene.name` its name.","group":""},"qa04_java_stage":{"id":"qa04_java_stage","name":"java: onStage","language":"java","source":"void onStage(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onStage","enabled":true,"description":"A Recorder or an Envelope moved to a new stage. `stage.target` is its name, `stage.stage` the new stage and `stage.previous` the old one: the Recorder's \"idle\", \"armed\", \"recording\" and \"overdub\", the Envelope's \"sustain\", \"release\" and \"end\". Not onStateChanged, which is hover and press.","group":""},"qa04_java_settled":{"id":"qa04_java_settled","name":"java: onSettled","language":"java","source":"void onSettled(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onSettled","enabled":true,"description":"A Ribbon, Crossfader or Vector Joystick finished going back to its rest. `settled.target` is its name and `settled.value` where it came to rest.","group":""},"qa04_java_bounce":{"id":"qa04_java_bounce","name":"java: onBounce","language":"java","source":"void onBounce(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onBounce","enabled":true,"description":"The Kinetic ball hit a wall. `bounce.target` is its name, `bounce.x` and `bounce.y` where it hit, and `bounce.vx` and `bounce.vy` its speed across and down.","group":""},"qa04_java_recall":{"id":"qa04_java_recall","name":"java: onRecall","language":"java","source":"void onRecall(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onRecall","enabled":true,"description":"The Constellation, in snap mode, moved to another preset. `recall.target` is its name, `recall.id` the preset and `recall.label` its label.","group":""},"qa04_java_zone":{"id":"qa04_java_zone","name":"java: onZone","language":"java","source":"void onZone(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onZone","enabled":true,"description":"A Meter's reading crossed into another zone, such as from green into red. `zone.target` is its name, `zone.zone` the new zone, `zone.previous` the old one and `zone.value` the reading.","group":""},"qa04_java_voiced":{"id":"qa04_java_voiced","name":"java: onVoiced","language":"java","source":"void onVoiced(CeContext ctx, CeEvent e) {\n  \n}\n","scope":"component","target":"self","event":"onVoiced","enabled":true,"description":"A Zone Splitter or Harmoniser turned a played note into other notes. `voiced.target` is its name, `voiced.note` and `voiced.velocity` the note played, and `voiced.out` the notes it made.","group":""}}}
