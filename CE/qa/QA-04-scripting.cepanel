            },
            "qa04_python_wheel": {
              "id": "qa04_python_wheel",
              "name": "python: onWheel",
              "language": "python",
              "source": "def onWheel(wheel):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onWheel",
              "enabled": true,
