              "id": "qa04_lua_recall",
              "name": "lua: onRecall",
              "language": "lua",
              "source": "function onRecall(recall)\n  \nend\n",
              "scope": "component",
              "target": "self",
              "event": "onRecall",
              "enabled": true,
              "description": "The Constellation snapped to a preset. recall.target, recall.id, recall.label. Snap mode only — blend mode does not fire it.",
              "group": ""
            },
            "qa04_lua_zone": {
              "id": "qa04_lua_zone",
              "name": "lua: onZone",
              "language": "lua",
