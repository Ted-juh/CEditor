        "Text": {
          "content": "cpp\n37 handlers"
        },
        "Scripts": {
          "_type": "Scripts",
          "_children": {
            "qa04_cpp_valueChange": {
              "id": "qa04_cpp_valueChange",
              "name": "cpp: onValueChange",
              "language": "cpp",
              "source": "void onValueChange(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onValueChange",
              "enabled": true,
              "description": "Fires over and over while the value is moving. Use it for things on screen that should follow the control.",
              "group": ""
            },
            "qa04_cpp_valueChanged": {
              "id": "qa04_cpp_valueChanged",
              "name": "cpp: onValueChanged",
              "language": "cpp",
              "source": "void onValueChanged(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onValueChanged",
              "enabled": true,
              "description": "Fires once, when the value settles. This is the moment to tell the synth.",
              "group": ""
            },
            "qa04_cpp_click": {
              "id": "qa04_cpp_click",
              "name": "cpp: onClick",
              "language": "cpp",
              "source": "void onClick(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onClick",
              "enabled": true,
              "description": "Clicked. mouse.x, mouse.y.",
              "group": ""
            },
            "qa04_cpp_doubleClick": {
              "id": "qa04_cpp_doubleClick",
              "name": "cpp: onDoubleClick",
