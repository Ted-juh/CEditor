              "group": ""
            },
            "qa04_lua_midiIn": {
              "id": "qa04_lua_midiIn",
              "name": "lua: onMidiIn",
              "language": "lua",
              "source": "function onMidiIn(midi)\n  \nend\n",
              "scope": "panel",
              "target": "*",
              "event": "onMidiIn",
              "enabled": true,
              "description": "Any MIDI arrived (raw). midi.bytes, midi.channel, midi.status.",
              "group": ""
            },
            "qa04_lua_ccIn": {
              "id": "qa04_lua_ccIn",
              "name": "lua: onCcIn",
              "language": "lua",
              "source": "function onCcIn(cc)\n  \nend\n",
              "scope": "panel",
              "target": "*",
              "event": "onCcIn",
              "enabled": true,
              "description": "A CC arrived. cc.channel, cc.cc, cc.value. cc.channel is 0-based here, unlike sendCC and onNoteIn.",
              "group": ""
            },
            "qa04_lua_noteIn": {
              "id": "qa04_lua_noteIn",
              "name": "lua: onNoteIn",
              "language": "lua",
              "source": "function onNoteIn(note)\n  \nend\n",
              "scope": "panel",
              "target": "*",
              "event": "onNoteIn",
              "enabled": true,
              "description": "A note was played. note.channel (1-16, matching sendNote), note.note, note.velocity. A note-on with velocity 0 counts as a note-off and arrives as onNoteOffIn instead.",
              "group": ""
            },
            "qa04_lua_noteOffIn": {
              "id": "qa04_lua_noteOffIn",
              "name": "lua: onNoteOffIn",
              "language": "lua",
              "source": "function onNoteOffIn(note)\n  \nend\n",
              "scope": "panel",
              "target": "*",
              "event": "onNoteOffIn",
              "enabled": true,
              "description": "A note was released. note.channel (1-16), note.note, note.velocity (the release velocity, 0 when the device sent a note-on with velocity 0 instead of a note-off).",
              "group": ""
            },
            "qa04_lua_sysexIn": {
              "id": "qa04_lua_sysexIn",
              "name": "lua: onSysexIn",
              "language": "lua",
              "source": "function onSysexIn(bytes)\n  \nend\n",
              "scope": "panel",
              "target": "*",
              "event": "onSysexIn",
              "enabled": true,
              "description": "Raw SysEx arrived.",
