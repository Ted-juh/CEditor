            },
            "qa04_cpp_beat": {
              "id": "qa04_cpp_beat",
              "name": "cpp: onBeat",
              "language": "cpp",
              "source": "void onBeat(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onBeat",
              "enabled": true,
              "description": "A beat passed. time.bar, time.beat, time.beats, time.bpm. Message-thread accurate (~30Hz), not sample-accurate.",
              "group": ""
            },
            "qa04_cpp_bar": {
              "id": "qa04_cpp_bar",
              "name": "cpp: onBar",
              "language": "cpp",
              "source": "void onBar(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onBar",
              "enabled": true,
              "description": "A bar passed. time.bar, time.beats, time.beatsPerBar. Fires with the downbeat, alongside onBeat.",
              "group": ""
            },
            "qa04_cpp_transport": {
              "id": "qa04_cpp_transport",
              "name": "cpp: onTransport",
              "language": "cpp",
              "source": "void onTransport(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onTransport",
              "enabled": true,
              "description": "The transport started, stopped, or changed tempo. time.playing, time.bpm, time.source.",
              "group": ""
            },
            "qa04_cpp_parameterReceived": {
              "id": "qa04_cpp_parameterReceived",
              "name": "cpp: onParameterReceived",
              "language": "cpp",
              "source": "void onParameterReceived(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onParameterReceived",
              "enabled": true,
              "description": "A value arrived, decoded via the DPD. info.parameter, info.value.",
              "group": ""
            },
            "qa04_cpp_dumpReceived": {
              "id": "qa04_cpp_dumpReceived",
              "name": "cpp: onDumpReceived",
              "language": "cpp",
              "source": "void onDumpReceived(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onDumpReceived",
              "enabled": true,
              "description": "A bulk dump arrived. dump.bytes, dump.kind. Use applyDump(dump.bytes) to fill the panel.",
              "group": ""
            },
            "qa04_cpp_presetChange": {
              "id": "qa04_cpp_presetChange",
              "name": "cpp: onPresetChange",
              "language": "cpp",
              "source": "void onPresetChange(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onPresetChange",
              "enabled": true,
              "description": "The current preset changed. preset.slot, preset.program, preset.name, preset.category, preset.bankId, preset.source (\"device\" when the instrument sent a Program Change, \"panel\" when recallPreset did it).",
              "group": ""
            },
            "qa04_cpp_midiIn": {
              "id": "qa04_cpp_midiIn",
              "name": "cpp: onMidiIn",
              "language": "cpp",
              "source": "void onMidiIn(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onMidiIn",
              "enabled": true,
              "description": "Any MIDI arrived (raw). midi.bytes, midi.channel, midi.status.",
              "group": ""
            },
            "qa04_cpp_ccIn": {
              "id": "qa04_cpp_ccIn",
              "name": "cpp: onCcIn",
              "language": "cpp",
              "source": "void onCcIn(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onCcIn",
              "enabled": true,
              "description": "A CC arrived. cc.channel, cc.cc, cc.value. cc.channel is 0-based here, unlike sendCC and onNoteIn.",
              "group": ""
            },
            "qa04_cpp_noteIn": {
              "id": "qa04_cpp_noteIn",
              "name": "cpp: onNoteIn",
              "language": "cpp",
              "source": "void onNoteIn(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onNoteIn",
              "enabled": true,
              "description": "A note was played. note.channel (1-16, matching sendNote), note.note, note.velocity. A note-on with velocity 0 counts as a note-off and arrives as onNoteOffIn instead.",
              "group": ""
            },
            "qa04_cpp_noteOffIn": {
              "id": "qa04_cpp_noteOffIn",
              "name": "cpp: onNoteOffIn",
              "language": "cpp",
              "source": "void onNoteOffIn(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onNoteOffIn",
              "enabled": true,
              "description": "A note was released. note.channel (1-16), note.note, note.velocity (the release velocity, 0 when the device sent a note-on with velocity 0 instead of a note-off).",
              "group": ""
            },
            "qa04_cpp_sysexIn": {
              "id": "qa04_cpp_sysexIn",
              "name": "cpp: onSysexIn",
              "language": "cpp",
              "source": "void onSysexIn(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onSysexIn",
              "enabled": true,
              "description": "Raw SysEx arrived.",
              "group": ""
            },
            "qa04_cpp_deviceConnected": {
              "id": "qa04_cpp_deviceConnected",
              "name": "cpp: onDeviceConnected",
              "language": "cpp",
              "source": "void onDeviceConnected(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onDeviceConnected",
              "enabled": true,
              "description": "A device connected.",
              "group": ""
            },
            "qa04_cpp_deviceDisconnected": {
              "id": "qa04_cpp_deviceDisconnected",
              "name": "cpp: onDeviceDisconnected",
              "language": "cpp",
              "source": "void onDeviceDisconnected(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onDeviceDisconnected",
              "enabled": true,
              "description": "A device disconnected.",
              "group": ""
            },
            "qa04_cpp_step": {
              "id": "qa04_cpp_step",
              "name": "cpp: onStep",
              "language": "cpp",
              "source": "void onStep(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onStep",
              "enabled": true,
              "description": "A sequencer advanced. step.target, step.index (1-based), step.of, step.notes. Raised by the Arpeggiator, Turing Machine, Phrase Sequencer and Looper.",
              "group": ""
            },
            "qa04_cpp_cycle": {
              "id": "qa04_cpp_cycle",
              "name": "cpp: onCycle",
              "language": "cpp",
              "source": "void onCycle(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onCycle",
              "enabled": true,
              "description": "A sequence or loop came back round. cycle.target, cycle.count (how many times since the panel opened). Arpeggiator, Turing, Looper, Orbit.",
              "group": ""
            },
            "qa04_cpp_hit": {
              "id": "qa04_cpp_hit",
              "name": "cpp: onHit",
              "language": "cpp",
              "source": "void onHit(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onHit",
              "enabled": true,
              "description": "A pad, key or ribbon was struck. hit.target, hit.id, hit.note, hit.velocity. Chord Pad, Drum Pads, Note Ribbon.",
              "group": ""
            },
            "qa04_cpp_release": {
              "id": "qa04_cpp_release",
              "name": "cpp: onRelease",
              "language": "cpp",
              "source": "void onRelease(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onRelease",
              "enabled": true,
              "description": "A pad, key or ribbon was released. release.target, release.id, release.note.",
              "group": ""
            },
            "qa04_cpp_scene": {
              "id": "qa04_cpp_scene",
              "name": "cpp: onScene",
              "language": "cpp",
              "source": "void onScene(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onScene",
              "enabled": true,
              "description": "The Setlist recalled a scene. scene.target, scene.index (1-based), scene.name. Fires on any recall, scripted or footswitch.",
              "group": ""
            },
            "qa04_cpp_stage": {
              "id": "qa04_cpp_stage",
              "name": "cpp: onStage",
              "language": "cpp",
              "source": "void onStage(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onStage",
              "enabled": true,
              "description": "A component entered a new stage. stage.target, stage.stage, stage.previous. Raised by the Recorder (\"idle\"/\"armed\"/\"recording\"/\"overdub\") and the Envelope (\"sustain\"/\"release\"/\"end\"). Not onStateChanged, which is a control's hover/pressed state.",
              "group": ""
            },
            "qa04_cpp_settled": {
              "id": "qa04_cpp_settled",
              "name": "cpp: onSettled",
              "language": "cpp",
              "source": "void onSettled(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onSettled",
              "enabled": true,
              "description": "A spring-return control finished gliding home. settled.target, settled.value. Ribbon, Crossfader, Vector Joystick.",
              "group": ""
            },
            "qa04_cpp_bounce": {
              "id": "qa04_cpp_bounce",
              "name": "cpp: onBounce",
              "language": "cpp",
              "source": "void onBounce(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onBounce",
              "enabled": true,
              "description": "The Kinetic ball hit a wall. bounce.target, bounce.x, bounce.y, bounce.vx, bounce.vy.",
              "group": ""
            },
            "qa04_cpp_recall": {
              "id": "qa04_cpp_recall",
              "name": "cpp: onRecall",
              "language": "cpp",
              "source": "void onRecall(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onRecall",
              "enabled": true,
              "description": "The Constellation snapped to a preset. recall.target, recall.id, recall.label. Snap mode only — blend mode does not fire it.",
              "group": ""
            },
            "qa04_cpp_zone": {
              "id": "qa04_cpp_zone",
              "name": "cpp: onZone",
              "language": "cpp",
              "source": "void onZone(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onZone",
              "enabled": true,
              "description": "A Meter crossed into a different threshold zone. zone.target, zone.zone, zone.previous, zone.value.",
              "group": ""
            },
            "qa04_cpp_voiced": {
              "id": "qa04_cpp_voiced",
              "name": "cpp: onVoiced",
              "language": "cpp",
              "source": "void onVoiced(CeContext& ctx, const CeEvent& event) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onVoiced",
              "enabled": true,
              "description": "A component turned a played note into other notes. voiced.target, voiced.note, voiced.velocity, voiced.out (the notes it produced). Raised by the Zone Splitter and the Harmoniser.",
              "group": ""
            }
          }
        }
      },
      "_type": "Control"
    },
