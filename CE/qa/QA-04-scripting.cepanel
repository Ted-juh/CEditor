            "qa04_lua_valueChange": {
              "id": "qa04_lua_valueChange",
              "name": "lua: onValueChange",
              "language": "lua",
              "source": "function onValueChange(value)\n  \nend\n",
              "scope": "component",
              "target": "self",
              "event": "onValueChange",
              "enabled": true,
              "description": "Fires over and over while the value is moving. Use it for things on screen that should follow the control.",
              "group": ""
            },
