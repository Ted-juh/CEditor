            "qa04_java_valueChange": {
              "id": "qa04_java_valueChange",
              "name": "java: onValueChange",
              "language": "java",
              "source": "void onValueChange(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onValueChange",
              "enabled": true,
              "description": "Fires over and over while the value is moving. Use it for things on screen that should follow the control.",
              "group": ""
            },
            "qa04_java_valueChanged": {
              "id": "qa04_java_valueChanged",
              "name": "java: onValueChanged",
              "language": "java",
              "source": "void onValueChanged(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onValueChanged",
              "enabled": true,
              "description": "Fires once, when the value settles. This is the moment to tell the synth.",
              "group": ""
            },
            "qa04_java_click": {
              "id": "qa04_java_click",
              "name": "java: onClick",
              "language": "java",
              "source": "void onClick(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onClick",
              "enabled": true,
              "description": "Clicked. mouse.x, mouse.y.",
              "group": ""
            },
            "qa04_java_doubleClick": {
              "id": "qa04_java_doubleClick",
              "name": "java: onDoubleClick",
              "language": "java",
              "source": "void onDoubleClick(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onDoubleClick",
              "enabled": true,
              "description": "Double-clicked.",
              "group": ""
            },
            "qa04_java_pointerDown": {
              "id": "qa04_java_pointerDown",
              "name": "java: onPointerDown",
              "language": "java",
              "source": "void onPointerDown(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onPointerDown",
              "enabled": true,
              "description": "Mouse pressed. mouse.x/.y/.button/.modifiers.",
              "group": ""
            },
            "qa04_java_pointerMove": {
              "id": "qa04_java_pointerMove",
              "name": "java: onPointerMove",
              "language": "java",
              "source": "void onPointerMove(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onPointerMove",
              "enabled": true,
              "description": "Mouse moved while down.",
              "group": ""
            },
            "qa04_java_pointerUp": {
              "id": "qa04_java_pointerUp",
              "name": "java: onPointerUp",
              "language": "java",
              "source": "void onPointerUp(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onPointerUp",
              "enabled": true,
              "description": "Mouse released.",
              "group": ""
            },
            "qa04_java_hoverStart": {
              "id": "qa04_java_hoverStart",
              "name": "java: onHoverStart",
              "language": "java",
              "source": "void onHoverStart(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onHoverStart",
              "enabled": true,
              "description": "Mouse entered the control.",
              "group": ""
            },
            "qa04_java_hoverEnd": {
              "id": "qa04_java_hoverEnd",
              "name": "java: onHoverEnd",
              "language": "java",
              "source": "void onHoverEnd(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onHoverEnd",
              "enabled": true,
              "description": "Mouse left the control.",
              "group": ""
            },
            "qa04_java_wheel": {
              "id": "qa04_java_wheel",
              "name": "java: onWheel",
              "language": "java",
              "source": "void onWheel(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onWheel",
              "enabled": true,
              "description": "Scrolled over the control. wheel.delta.",
              "group": ""
            },
            "qa04_java_stateChanged": {
              "id": "qa04_java_stateChanged",
              "name": "java: onStateChanged",
              "language": "java",
              "source": "void onStateChanged(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onStateChanged",
              "enabled": true,
              "description": "The control changed state: hover, pressed or disabled.",
              "group": ""
            },
            "qa04_java_controlChanged": {
              "id": "qa04_java_controlChanged",
              "name": "java: onControlChanged",
              "language": "java",
              "source": "void onControlChanged(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onControlChanged",
              "enabled": true,
              "description": "Any control changed. info.target, info.value.",
              "group": ""
            },
            "qa04_java_timer": {
              "id": "qa04_java_timer",
              "name": "java: onTimer",
              "language": "java",
              "source": "void onTimer(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onTimer",
              "enabled": true,
              "description": "A started timer fired. info.id.",
              "group": ""
            },
            "qa04_java_beat": {
              "id": "qa04_java_beat",
              "name": "java: onBeat",
              "language": "java",
              "source": "void onBeat(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onBeat",
              "enabled": true,
              "description": "A beat passed. time.bar, time.beat, time.beats, time.bpm. Message-thread accurate (~30Hz), not sample-accurate.",
              "group": ""
            },
            "qa04_java_bar": {
              "id": "qa04_java_bar",
              "name": "java: onBar",
              "language": "java",
              "source": "void onBar(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onBar",
              "enabled": true,
              "description": "A bar passed. time.bar, time.beats, time.beatsPerBar. Fires with the downbeat, alongside onBeat.",
              "group": ""
            },
            "qa04_java_transport": {
              "id": "qa04_java_transport",
              "name": "java: onTransport",
              "language": "java",
              "source": "void onTransport(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onTransport",
              "enabled": true,
              "description": "The transport started, stopped, or changed tempo. time.playing, time.bpm, time.source.",
              "group": ""
            },
            "qa04_java_parameterReceived": {
              "id": "qa04_java_parameterReceived",
              "name": "java: onParameterReceived",
              "language": "java",
              "source": "void onParameterReceived(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onParameterReceived",
              "enabled": true,
              "description": "A value arrived, decoded via the DPD. info.parameter, info.value.",
              "group": ""
            },
            "qa04_java_dumpReceived": {
              "id": "qa04_java_dumpReceived",
              "name": "java: onDumpReceived",
              "language": "java",
              "source": "void onDumpReceived(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onDumpReceived",
              "enabled": true,
              "description": "A bulk dump arrived. dump.bytes, dump.kind. Use applyDump(dump.bytes) to fill the panel.",
              "group": ""
            },
            "qa04_java_presetChange": {
              "id": "qa04_java_presetChange",
              "name": "java: onPresetChange",
              "language": "java",
              "source": "void onPresetChange(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onPresetChange",
              "enabled": true,
              "description": "The current preset changed. preset.slot, preset.program, preset.name, preset.category, preset.bankId, preset.source (\"device\" when the instrument sent a Program Change, \"panel\" when recallPreset did it).",
              "group": ""
            },
            "qa04_java_midiIn": {
              "id": "qa04_java_midiIn",
              "name": "java: onMidiIn",
              "language": "java",
              "source": "void onMidiIn(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onMidiIn",
              "enabled": true,
              "description": "Any MIDI arrived (raw). midi.bytes, midi.channel, midi.status.",
              "group": ""
            },
            "qa04_java_ccIn": {
              "id": "qa04_java_ccIn",
              "name": "java: onCcIn",
              "language": "java",
              "source": "void onCcIn(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onCcIn",
              "enabled": true,
              "description": "A CC arrived. cc.channel, cc.cc, cc.value. cc.channel is 0-based here, unlike sendCC and onNoteIn.",
              "group": ""
            },
            "qa04_java_noteIn": {
              "id": "qa04_java_noteIn",
              "name": "java: onNoteIn",
              "language": "java",
              "source": "void onNoteIn(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onNoteIn",
              "enabled": true,
              "description": "A note was played. note.channel (1-16, matching sendNote), note.note, note.velocity. A note-on with velocity 0 counts as a note-off and arrives as onNoteOffIn instead.",
              "group": ""
            },
            "qa04_java_noteOffIn": {
              "id": "qa04_java_noteOffIn",
              "name": "java: onNoteOffIn",
              "language": "java",
              "source": "void onNoteOffIn(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onNoteOffIn",
              "enabled": true,
              "description": "A note was released. note.channel (1-16), note.note, note.velocity (the release velocity, 0 when the device sent a note-on with velocity 0 instead of a note-off).",
              "group": ""
            },
            "qa04_java_sysexIn": {
              "id": "qa04_java_sysexIn",
              "name": "java: onSysexIn",
              "language": "java",
              "source": "void onSysexIn(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onSysexIn",
              "enabled": true,
              "description": "Raw SysEx arrived.",
              "group": ""
            },
            "qa04_java_deviceConnected": {
              "id": "qa04_java_deviceConnected",
              "name": "java: onDeviceConnected",
              "language": "java",
              "source": "void onDeviceConnected(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onDeviceConnected",
              "enabled": true,
              "description": "A device connected.",
              "group": ""
            },
            "qa04_java_deviceDisconnected": {
              "id": "qa04_java_deviceDisconnected",
              "name": "java: onDeviceDisconnected",
              "language": "java",
              "source": "void onDeviceDisconnected(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "panel",
              "target": "*",
              "event": "onDeviceDisconnected",
              "enabled": true,
              "description": "A device disconnected.",
              "group": ""
            },
            "qa04_java_step": {
              "id": "qa04_java_step",
              "name": "java: onStep",
              "language": "java",
              "source": "void onStep(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onStep",
              "enabled": true,
              "description": "A sequencer advanced. step.target, step.index (1-based), step.of, step.notes. Raised by the Arpeggiator, Turing Machine, Phrase Sequencer and Looper.",
              "group": ""
            },
            "qa04_java_cycle": {
              "id": "qa04_java_cycle",
              "name": "java: onCycle",
              "language": "java",
              "source": "void onCycle(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onCycle",
              "enabled": true,
              "description": "A sequence or loop came back round. cycle.target, cycle.count (how many times since the panel opened). Arpeggiator, Turing, Looper, Orbit.",
              "group": ""
            },
            "qa04_java_hit": {
              "id": "qa04_java_hit",
              "name": "java: onHit",
              "language": "java",
              "source": "void onHit(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onHit",
              "enabled": true,
              "description": "A pad, key or ribbon was struck. hit.target, hit.id, hit.note, hit.velocity. Chord Pad, Drum Pads, Note Ribbon.",
              "group": ""
            },
            "qa04_java_release": {
              "id": "qa04_java_release",
              "name": "java: onRelease",
              "language": "java",
              "source": "void onRelease(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onRelease",
              "enabled": true,
              "description": "A pad, key or ribbon was released. release.target, release.id, release.note.",
              "group": ""
            },
            "qa04_java_scene": {
              "id": "qa04_java_scene",
              "name": "java: onScene",
              "language": "java",
              "source": "void onScene(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onScene",
              "enabled": true,
              "description": "The Setlist recalled a scene. scene.target, scene.index (1-based), scene.name. Fires on any recall, scripted or footswitch.",
              "group": ""
            },
            "qa04_java_stage": {
              "id": "qa04_java_stage",
              "name": "java: onStage",
              "language": "java",
              "source": "void onStage(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onStage",
              "enabled": true,
              "description": "A component entered a new stage. stage.target, stage.stage, stage.previous. Raised by the Recorder (\"idle\"/\"armed\"/\"recording\"/\"overdub\") and the Envelope (\"sustain\"/\"release\"/\"end\"). Not onStateChanged, which is a control's hover/pressed state.",
              "group": ""
            },
            "qa04_java_settled": {
              "id": "qa04_java_settled",
              "name": "java: onSettled",
              "language": "java",
              "source": "void onSettled(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onSettled",
              "enabled": true,
              "description": "A spring-return control finished gliding home. settled.target, settled.value. Ribbon, Crossfader, Vector Joystick.",
              "group": ""
            },
            "qa04_java_bounce": {
              "id": "qa04_java_bounce",
              "name": "java: onBounce",
              "language": "java",
              "source": "void onBounce(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onBounce",
              "enabled": true,
              "description": "The Kinetic ball hit a wall. bounce.target, bounce.x, bounce.y, bounce.vx, bounce.vy.",
              "group": ""
            },
            "qa04_java_recall": {
              "id": "qa04_java_recall",
              "name": "java: onRecall",
              "language": "java",
              "source": "void onRecall(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onRecall",
              "enabled": true,
              "description": "The Constellation snapped to a preset. recall.target, recall.id, recall.label. Snap mode only — blend mode does not fire it.",
              "group": ""
            },
            "qa04_java_zone": {
              "id": "qa04_java_zone",
              "name": "java: onZone",
              "language": "java",
              "source": "void onZone(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onZone",
              "enabled": true,
              "description": "A Meter crossed into a different threshold zone. zone.target, zone.zone, zone.previous, zone.value.",
              "group": ""
            },
            "qa04_java_voiced": {
              "id": "qa04_java_voiced",
              "name": "java: onVoiced",
              "language": "java",
              "source": "void onVoiced(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onVoiced",
              "enabled": true,
              "description": "A component turned a played note into other notes. voiced.target, voiced.note, voiced.velocity, voiced.out (the notes it produced). Raised by the Zone Splitter and the Harmoniser.",
              "group": ""
            }
          }
        }
      },
