    {
      "_children": {
        "Core": {"name":"group_cpp_55_handlers_one_per_event","id":"qa_group_4","controlType":"Label"},
        "Transform": {"x":28,"y":2628,"width":1544,"height":26},
        "Background": {"_children":{"Fill":{"colour":"FF23282D"},"Border":{"thickness":1,"colour":"3389C2FF"},"Corners":{"radius":4}}},
        "Text": {"content":"cpp — 55 handlers, one per event","_children":{"Font":{"size":13,"bold":true}}},
        "ContentLayout": {"horizontalAlign":"left","paddingLeft":10,"paddingRight":10,"paddingTop":3,"paddingBottom":3}
      },
      "_type": "Control"
