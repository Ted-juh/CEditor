        },
        "Text": {
          "content": "python\n37 handlers"
        },
        "Scripts": {
          "_type": "Scripts",
          "_children": {
            "qa04_python_valueChange": {
              "id": "qa04_python_valueChange",
              "name": "python: onValueChange",
              "language": "python",
              "source": "def onValueChange(value):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onValueChange",
              "enabled": true,
              "description": "Fires over and over while the value is moving. Use it for things on screen that should follow the control.",
              "group": ""
            },
            "qa04_python_valueChanged": {
              "id": "qa04_python_valueChanged",
              "name": "python: onValueChanged",
              "language": "python",
              "source": "def onValueChanged(value):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onValueChanged",
              "enabled": true,
              "description": "Fires once, when the value settles. This is the moment to tell the synth.",
              "group": ""
            },
            "qa04_python_click": {
              "id": "qa04_python_click",
              "name": "python: onClick",
              "language": "python",
              "source": "def onClick(mouse):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onClick",
              "enabled": true,
              "description": "Clicked. mouse.x, mouse.y.",
              "group": ""
            },
            "qa04_python_doubleClick": {
              "id": "qa04_python_doubleClick",
              "name": "python: onDoubleClick",
              "language": "python",
              "source": "def onDoubleClick(mouse):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onDoubleClick",
              "enabled": true,
              "description": "Double-clicked.",
              "group": ""
            },
            "qa04_python_pointerDown": {
              "id": "qa04_python_pointerDown",
              "name": "python: onPointerDown",
              "language": "python",
              "source": "def onPointerDown(mouse):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onPointerDown",
              "enabled": true,
              "description": "Mouse pressed. mouse.x/.y/.button/.modifiers.",
              "group": ""
            },
            "qa04_python_pointerMove": {
              "id": "qa04_python_pointerMove",
              "name": "python: onPointerMove",
              "language": "python",
              "source": "def onPointerMove(mouse):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onPointerMove",
              "enabled": true,
              "description": "Mouse moved while down.",
              "group": ""
            },
            "qa04_python_pointerUp": {
              "id": "qa04_python_pointerUp",
              "name": "python: onPointerUp",
              "language": "python",
              "source": "def onPointerUp(mouse):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onPointerUp",
              "enabled": true,
              "description": "Mouse released.",
              "group": ""
            },
            "qa04_python_hoverStart": {
              "id": "qa04_python_hoverStart",
              "name": "python: onHoverStart",
              "language": "python",
              "source": "def onHoverStart():\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onHoverStart",
              "enabled": true,
