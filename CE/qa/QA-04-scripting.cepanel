              "group": ""
            },
            "qa04_python_stateChanged": {
              "id": "qa04_python_stateChanged",
              "name": "python: onStateChanged",
              "language": "python",
              "source": "def onStateChanged(state):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onStateChanged",
              "enabled": true,
              "description": "The control changed state: hover, pressed or disabled.",
              "group": ""
            },
            "qa04_python_controlChanged": {
              "id": "qa04_python_controlChanged",
              "name": "python: onControlChanged",
              "language": "python",
              "source": "def onControlChanged(info):\n    pass\n",
              "scope": "panel",
              "target": "*",
              "event": "onControlChanged",
              "enabled": true,
              "description": "Any control changed. info.target, info.value.",
              "group": ""
            },
            "qa04_python_timer": {
              "id": "qa04_python_timer",
              "name": "python: onTimer",
              "language": "python",
              "source": "def onTimer(info):\n    pass\n",
              "scope": "panel",
              "target": "*",
              "event": "onTimer",
              "enabled": true,
              "description": "A started timer fired. info.id.",
              "group": ""
            },
            "qa04_python_beat": {
              "id": "qa04_python_beat",
              "name": "python: onBeat",
              "language": "python",
              "source": "def onBeat(time):\n    pass\n",
              "scope": "panel",
              "target": "*",
              "event": "onBeat",
              "enabled": true,
              "description": "A beat passed. time.bar, time.beat, time.beats, time.bpm. Message-thread accurate (~30Hz), not sample-accurate.",
              "group": ""
            },
            "qa04_python_bar": {
              "id": "qa04_python_bar",
              "name": "python: onBar",
              "language": "python",
              "source": "def onBar(time):\n    pass\n",
              "scope": "panel",
              "target": "*",
              "event": "onBar",
              "enabled": true,
              "description": "A bar passed. time.bar, time.beats, time.beatsPerBar. Fires with the downbeat, alongside onBeat.",
              "group": ""
            },
            "qa04_python_transport": {
              "id": "qa04_python_transport",
              "name": "python: onTransport",
              "language": "python",
              "source": "def onTransport(time):\n    pass\n",
              "scope": "panel",
              "target": "*",
              "event": "onTransport",
              "enabled": true,
              "description": "The transport started, stopped, or changed tempo. time.playing, time.bpm, time.source.",
              "group": ""
            },
            "qa04_python_parameterReceived": {
              "id": "qa04_python_parameterReceived",
              "name": "python: onParameterReceived",
              "language": "python",
              "source": "def onParameterReceived(info):\n    pass\n",
              "scope": "panel",
              "target": "*",
              "event": "onParameterReceived",
              "enabled": true,
              "description": "A value arrived, decoded via the DPD. info.parameter, info.value.",
              "group": ""
            },
            "qa04_python_dumpReceived": {
              "id": "qa04_python_dumpReceived",
              "name": "python: onDumpReceived",
              "language": "python",
              "source": "def onDumpReceived(dump):\n    pass\n",
              "scope": "panel",
              "target": "*",
              "event": "onDumpReceived",
              "enabled": true,
              "description": "A bulk dump arrived. dump.bytes, dump.kind. Use applyDump(dump.bytes) to fill the panel.",
              "group": ""
            },
            "qa04_python_presetChange": {
              "id": "qa04_python_presetChange",
              "name": "python: onPresetChange",
              "language": "python",
              "source": "def onPresetChange(preset):\n    pass\n",
              "scope": "panel",
              "target": "*",
              "event": "onPresetChange",
              "enabled": true,
              "description": "The current preset changed. preset.slot, preset.program, preset.name, preset.category, preset.bankId, preset.source (\"device\" when the instrument sent a Program Change, \"panel\" when recallPreset did it).",
              "group": ""
            },
            "qa04_python_midiIn": {
              "id": "qa04_python_midiIn",
              "name": "python: onMidiIn",
              "language": "python",
              "source": "def onMidiIn(midi):\n    pass\n",
              "scope": "panel",
              "target": "*",
              "event": "onMidiIn",
              "enabled": true,
              "description": "Any MIDI arrived (raw). midi.bytes, midi.channel, midi.status.",
              "group": ""
            },
            "qa04_python_ccIn": {
              "id": "qa04_python_ccIn",
              "name": "python: onCcIn",
              "language": "python",
              "source": "def onCcIn(cc):\n    pass\n",
              "scope": "panel",
              "target": "*",
              "event": "onCcIn",
              "enabled": true,
              "description": "A CC arrived. cc.channel, cc.cc, cc.value. cc.channel is 0-based here, unlike sendCC and onNoteIn.",
              "group": ""
            },
            "qa04_python_noteIn": {
              "id": "qa04_python_noteIn",
              "name": "python: onNoteIn",
              "language": "python",
              "source": "def onNoteIn(note):\n    pass\n",
              "scope": "panel",
              "target": "*",
              "event": "onNoteIn",
              "enabled": true,
              "description": "A note was played. note.channel (1-16, matching sendNote), note.note, note.velocity. A note-on with velocity 0 counts as a note-off and arrives as onNoteOffIn instead.",
              "group": ""
            },
            "qa04_python_noteOffIn": {
              "id": "qa04_python_noteOffIn",
              "name": "python: onNoteOffIn",
              "language": "python",
              "source": "def onNoteOffIn(note):\n    pass\n",
              "scope": "panel",
              "target": "*",
              "event": "onNoteOffIn",
              "enabled": true,
              "description": "A note was released. note.channel (1-16), note.note, note.velocity (the release velocity, 0 when the device sent a note-on with velocity 0 instead of a note-off).",
              "group": ""
            },
            "qa04_python_sysexIn": {
              "id": "qa04_python_sysexIn",
              "name": "python: onSysexIn",
              "language": "python",
              "source": "def onSysexIn(bytes):\n    pass\n",
              "scope": "panel",
              "target": "*",
              "event": "onSysexIn",
              "enabled": true,
              "description": "Raw SysEx arrived.",
              "group": ""
            },
            "qa04_python_deviceConnected": {
              "id": "qa04_python_deviceConnected",
              "name": "python: onDeviceConnected",
              "language": "python",
              "source": "def onDeviceConnected(device):\n    pass\n",
              "scope": "panel",
              "target": "*",
              "event": "onDeviceConnected",
              "enabled": true,
              "description": "A device connected.",
              "group": ""
            },
            "qa04_python_deviceDisconnected": {
              "id": "qa04_python_deviceDisconnected",
              "name": "python: onDeviceDisconnected",
              "language": "python",
              "source": "def onDeviceDisconnected(device):\n    pass\n",
              "scope": "panel",
              "target": "*",
              "event": "onDeviceDisconnected",
              "enabled": true,
              "description": "A device disconnected.",
              "group": ""
            },
            "qa04_python_step": {
              "id": "qa04_python_step",
              "name": "python: onStep",
              "language": "python",
              "source": "def onStep(step):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onStep",
              "enabled": true,
              "description": "A sequencer advanced. step.target, step.index (1-based), step.of, step.notes. Raised by the Arpeggiator, Turing Machine, Phrase Sequencer and Looper.",
              "group": ""
            },
            "qa04_python_cycle": {
              "id": "qa04_python_cycle",
              "name": "python: onCycle",
              "language": "python",
              "source": "def onCycle(cycle):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onCycle",
              "enabled": true,
              "description": "A sequence or loop came back round. cycle.target, cycle.count (how many times since the panel opened). Arpeggiator, Turing, Looper, Orbit.",
              "group": ""
            },
            "qa04_python_hit": {
              "id": "qa04_python_hit",
              "name": "python: onHit",
              "language": "python",
              "source": "def onHit(hit):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onHit",
              "enabled": true,
              "description": "A pad, key or ribbon was struck. hit.target, hit.id, hit.note, hit.velocity. Chord Pad, Drum Pads, Note Ribbon.",
              "group": ""
            },
            "qa04_python_release": {
              "id": "qa04_python_release",
              "name": "python: onRelease",
              "language": "python",
              "source": "def onRelease(release):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onRelease",
              "enabled": true,
              "description": "A pad, key or ribbon was released. release.target, release.id, release.note.",
              "group": ""
            },
            "qa04_python_scene": {
              "id": "qa04_python_scene",
              "name": "python: onScene",
              "language": "python",
              "source": "def onScene(scene):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onScene",
              "enabled": true,
              "description": "The Setlist recalled a scene. scene.target, scene.index (1-based), scene.name. Fires on any recall, scripted or footswitch.",
              "group": ""
            },
            "qa04_python_stage": {
              "id": "qa04_python_stage",
              "name": "python: onStage",
              "language": "python",
              "source": "def onStage(stage):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onStage",
              "enabled": true,
              "description": "A component entered a new stage. stage.target, stage.stage, stage.previous. Raised by the Recorder (\"idle\"/\"armed\"/\"recording\"/\"overdub\") and the Envelope (\"sustain\"/\"release\"/\"end\"). Not onStateChanged, which is a control's hover/pressed state.",
              "group": ""
            },
            "qa04_python_settled": {
              "id": "qa04_python_settled",
              "name": "python: onSettled",
              "language": "python",
              "source": "def onSettled(settled):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onSettled",
              "enabled": true,
              "description": "A spring-return control finished gliding home. settled.target, settled.value. Ribbon, Crossfader, Vector Joystick.",
              "group": ""
            },
            "qa04_python_bounce": {
              "id": "qa04_python_bounce",
              "name": "python: onBounce",
              "language": "python",
              "source": "def onBounce(bounce):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onBounce",
              "enabled": true,
              "description": "The Kinetic ball hit a wall. bounce.target, bounce.x, bounce.y, bounce.vx, bounce.vy.",
              "group": ""
            },
            "qa04_python_recall": {
              "id": "qa04_python_recall",
              "name": "python: onRecall",
              "language": "python",
              "source": "def onRecall(recall):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onRecall",
              "enabled": true,
              "description": "The Constellation snapped to a preset. recall.target, recall.id, recall.label. Snap mode only — blend mode does not fire it.",
              "group": ""
            },
            "qa04_python_zone": {
              "id": "qa04_python_zone",
              "name": "python: onZone",
              "language": "python",
              "source": "def onZone(zone):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onZone",
              "enabled": true,
              "description": "A Meter crossed into a different threshold zone. zone.target, zone.zone, zone.previous, zone.value.",
              "group": ""
            },
            "qa04_python_voiced": {
              "id": "qa04_python_voiced",
              "name": "python: onVoiced",
              "language": "python",
              "source": "def onVoiced(voiced):\n    pass\n",
              "scope": "component",
              "target": "self",
              "event": "onVoiced",
              "enabled": true,
              "description": "A component turned a played note into other notes. voiced.target, voiced.note, voiced.velocity, voiced.out (the notes it produced). Raised by the Zone Splitter and the Harmoniser.",
              "group": ""
            }
          }
        }
      },
      "_type": "Control"
