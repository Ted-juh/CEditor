            },
            "qa04_lua_step": {
              "id": "qa04_lua_step",
              "name": "lua: onStep",
              "language": "lua",
              "source": "function onStep(step)\n  \nend\n",
              "scope": "component",
              "target": "self",
              "event": "onStep",
              "enabled": true,
              "description": "A sequencer advanced. step.target, step.index (1-based), step.of, step.notes. Raised by the Arpeggiator, Turing Machine, Phrase Sequencer and Looper.",
              "group": ""
            },
            "qa04_lua_cycle": {
              "id": "qa04_lua_cycle",
              "name": "lua: onCycle",
              "language": "lua",
              "source": "function onCycle(cycle)\n  \nend\n",
              "scope": "component",
              "target": "self",
              "event": "onCycle",
              "enabled": true,
              "description": "A sequence or loop came back round. cycle.target, cycle.count (how many times since the panel opened). Arpeggiator, Turing, Looper, Orbit.",
              "group": ""
            },
            "qa04_lua_hit": {
              "id": "qa04_lua_hit",
              "name": "lua: onHit",
              "language": "lua",
              "source": "function onHit(hit)\n  \nend\n",
              "scope": "component",
              "target": "self",
              "event": "onHit",
              "enabled": true,
              "description": "A pad, key or ribbon was struck. hit.target, hit.id, hit.note, hit.velocity. Chord Pad, Drum Pads, Note Ribbon.",
              "group": ""
            },
            "qa04_lua_release": {
              "id": "qa04_lua_release",
