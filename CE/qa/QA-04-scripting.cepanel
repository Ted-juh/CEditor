        "Scripts": {
          "_type": "Scripts",
          "_children": {
            "qa04_csharp_valueChange": {
              "id": "qa04_csharp_valueChange",
              "name": "csharp: onValueChange",
              "language": "csharp",
              "source": "void onValueChange(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onValueChange",
              "enabled": true,
              "description": "Fires over and over while the value is moving. Use it for things on screen that should follow the control.",
              "group": ""
            },
            "qa04_csharp_valueChanged": {
              "id": "qa04_csharp_valueChanged",
              "name": "csharp: onValueChanged",
              "language": "csharp",
              "source": "void onValueChanged(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onValueChanged",
              "enabled": true,
              "description": "Fires once, when the value settles. This is the moment to tell the synth.",
              "group": ""
            },
            "qa04_csharp_click": {
              "id": "qa04_csharp_click",
              "name": "csharp: onClick",
              "language": "csharp",
              "source": "void onClick(CeContext ctx, CeEvent e) {\n  \n}\n",
              "scope": "component",
              "target": "self",
              "event": "onClick",
              "enabled": true,
              "description": "Clicked. mouse.x, mouse.y.",
              "group": ""
            },
            "qa04_csharp_doubleClick": {
              "id": "qa04_csharp_doubleClick",
              "name": "csharp: onDoubleClick",
