          "labelMinMaxOffsetX": 0,
          "labelMinMaxOffsetY": 0,
          "labelReadoutPlacement": "auto",
          "labelReadoutGap": 14,
          "labelReadoutOffsetX": 0,
          "labelReadoutOffsetY": 0,
          "precision": 2,
          "prefix": "",
          "suffix": "",
          "unit": "",
          "rangeSeparator": " - ",
          "bandSeparator": " | ",
          "showSign": false,
          "emitClick": true,
          "emitValueChange": true,
          "emitStateChange": true
        },
        "Bindings": {
          "_type": "Bindings",
          "enabled": true,
          "debug": false,
          "_children": {}
        },
        "DeviceBindings": {
          "_type": "DeviceBindings",
          "enabled": true,
          "debug": false,
          "bindings": []
        },
        "States": {
          "_type": "States",
          "enabled": true,
          "debug": false,
          "priority": [
            "disabled",
            "dragging",
            "pressed",
            "activehandlestart",
            "activehandlecurrent",
            "activehandleend",
            "hover",
            "focused"
          ],
          "_children": {
            "Hover": {
              "_type": "State",
              "name": "Hover",
              "group": "interaction",
              "description": "Slightly lift the active pointer while hovering.",
              "enabled": true,
              "when": {
                "hover": true
              },
              "patches": {
                "component": {},
                "parts": {
                  "pointerCurrent": {
                    "Layout.scale": 1.06
                  }
                }
              }
            },
            "Pressed": {
              "_type": "State",
              "name": "Pressed",
              "group": "interaction",
              "description": "Tighten the active pointer while pressing.",
              "enabled": true,
              "when": {
                "pressed": true
              },
              "patches": {
                "component": {},
                "parts": {
                  "pointerCurrent": {
                    "Layout.scale": 0.96
                  }
                }
              }
            },
            "Dragging": {
              "_type": "State",
              "name": "Dragging",
              "group": "interaction",
              "description": "Brighten the active body span while dragging.",
              "enabled": true,
              "when": {
                "dragging": true
              },
              "patches": {
                "component": {},
                "parts": {
                  "bodyTrackFill": {
                    "Background.Fill.colour": "FF71B8F1"
                  },
                  "bodySelectedRange": {
                    "Background.Fill.colour": "FF9FD0FF"
                  },
                  "pointerCurrent": {
                    "Background.Fill.colour": "FFFFFFFF",
                    "Layout.scale": 1.08
                  }
                }
              }
            },
            "Focused": {
              "_type": "State",
              "name": "Focused",
              "group": "interaction",
              "description": "Accent the active pointer while focused.",
              "enabled": true,
              "when": {
                "focused": true
              },
              "patches": {
                "component": {},
                "parts": {
                  "pointerCurrent": {
                    "Background.Border.colour": "FF89C2FF"
                  },
                  "labelValue": {
                    "Text.Fill.colour": "FFDAEEFF"
                  }
                }
              }
            },
            "ActiveHandleStart": {
              "_type": "State",
              "name": "ActiveHandleStart",
              "group": "logical",
              "description": "Emphasize the start handle when it is active.",
              "enabled": true,
              "when": {
                "activeHandle": "start"
              },
              "patches": {
                "component": {},
                "parts": {
                  "pointerStart": {
                    "Layout.scale": 1.08
                  }
                }
              }
            },
            "ActiveHandleCurrent": {
              "_type": "State",
              "name": "ActiveHandleCurrent",
              "group": "logical",
              "description": "Emphasize the current handle when it is active.",
              "enabled": true,
              "when": {
                "activeHandle": "current"
              },
              "patches": {
                "component": {},
                "parts": {
                  "pointerCurrent": {
                    "Layout.scale": 1.08
                  }
                }
              }
            },
            "ActiveHandleEnd": {
              "_type": "State",
              "name": "ActiveHandleEnd",
              "group": "logical",
              "description": "Emphasize the end handle when it is active.",
              "enabled": true,
              "when": {
                "activeHandle": "end"
              },
              "patches": {
                "component": {},
                "parts": {
                  "pointerEnd": {
                    "Layout.scale": 1.08
                  }
                }
              }
            },
            "Disabled": {
              "_type": "State",
              "name": "Disabled",
              "group": "system",
              "description": "Dim the slider when disabled.",
              "enabled": true,
              "when": {
                "disabled": true
              },
              "patches": {
                "component": {
                  "Transform.opacity": 0.55
                },
                "parts": {}
              }
            }
          }
        },
        "Animations": {
          "_type": "Animations",
          "enabled": true,
          "debug": false,
          "_children": {
            "pointerSlide": {
              "_type": "Animation",
              "name": "pointerSlide",
              "enabled": true,
              "kind": "transition",
              "trigger": {
                "type": "valueChange",
                "source": "value.normalized"
              },
              "targets": [
                {
                  "path": "Parts.pointerCurrent.Layout.x",
                  "properties": [
                    "transform"
                  ]
                },
                {
                  "path": "Parts.pointerCurrent.Layout.y",
                  "properties": [
                    "transform"
                  ]
                },
                {
                  "path": "Parts.pointerStart.Layout.x",
                  "properties": [
                    "transform"
                  ]
                },
                {
                  "path": "Parts.pointerStart.Layout.y",
                  "properties": [
                    "transform"
                  ]
                },
                {
                  "path": "Parts.pointerEnd.Layout.x",
                  "properties": [
                    "transform"
                  ]
                },
                {
                  "path": "Parts.pointerEnd.Layout.y",
                  "properties": [
                    "transform"
                  ]
                }
              ],
              "duration": 140,
              "delay": 0,
              "easing": "outCubic"
            },
            "rangeSlide": {
              "_type": "Animation",
              "name": "rangeSlide",
              "enabled": true,
              "kind": "transition",
              "trigger": {
                "type": "valueChange",
                "source": "value.normalized"
              },
              "targets": [
                {
                  "path": "Parts.bodyTrackFill.Layout.width",
                  "properties": [
                    "size"
                  ]
                },
                {
                  "path": "Parts.bodySelectedRange.Layout.width",
                  "properties": [
                    "size"
                  ]
                }
              ],
              "duration": 140,
              "delay": 0,
              "easing": "outCubic"
            }
          }
        },
        "Scripts": {
          "_type": "Scripts",
          "enabled": true,
          "runInPreview": true,
          "scripts": [
            {
              "id": "qa02_onValueChanged",
              "name": "QA-02 value echo",
              "language": "lua",
              "source": "function onValueChanged(value)\n  log(\"qa02 slider: \" .. tostring(value))\nend",
              "scope": "component",
              "target": "self",
              "event": "onValueChanged",
              "enabled": true,
              "description": "Proves a per-control script survives serialization and reload.",
              "group": ""
            }
          ]
        }
      }
    },
