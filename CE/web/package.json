{
  "name": "ceditor-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --import ./test/support/register-svelte.mjs --test",
    "test:script-exports": "node scripts/validate-script-exports.mjs",
    "qa:panels": "node ../../tools/scripts/qa/make-qa-panels.mjs",
    "docs:manual": "node scripts/generate-scripting-manual.mjs",
    "test:all": "npm test && npm run test:script-exports",
    "test:browser": "vite build --config browser-checks/vite.config.mjs && node browser-checks/run.mjs && node browser-checks/textPlacement.mjs && node browser-checks/playerInbound.mjs && node browser-checks/learnChips.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "playwright-core": "^1.62.1",
    "svelte": "^5.0.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "acorn": "^8.17.0",
    "luaparse": "^0.3.1",
    "lucide-svelte": "^1.0.1",
    "wasmoon": "^1.16.0"
  }
}
