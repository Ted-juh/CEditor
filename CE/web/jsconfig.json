{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "target": "ES2022"
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.svelte",
    "browser-checks/**/*.js",
    "browser-checks/**/*.mjs",
    "browser-checks/**/*.svelte"
  ],
  "exclude": ["dist", "dist-scenery", "node_modules"]
}
